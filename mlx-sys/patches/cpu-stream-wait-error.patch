 namespace metal {
 
+namespace {
+
+// pmetal: a CPU-stream task runs on MLX's scheduler thread, where nothing
+// catches an exception — a GPU command-buffer error thrown there by a
+// cross-stream wait called std::terminate (a GPU-watchdog timeout during
+// weight loading aborted the process instead of failing its eval). Instead, a
+// CPU-stream wait that sees an error records it here as that stream's pending
+// error, and every event the stream signals afterwards carries it to whoever
+// waits on it (a host wait throws it; a GPU wait poisons its encoder). Like
+// the GPU encoder's sticky error, it is kept until a host wait reports it.
+struct CpuStreamErrors {
+  std::mutex mutex;
+  std::unordered_map<int, std::shared_ptr<std::string>> pending;
+  // The most recently reported error. A CPU-stream wait can still observe it
+  // on an event after the host has thrown it (the host may report it through
+  // another stream first); it must not become pending again.
+  std::weak_ptr<std::string> last_reported;
+};
+
+CpuStreamErrors& cpu_stream_errors() {
+  // Leaked like the scheduler singleton: scheduler threads may still run
+  // tasks during static destruction.
+  static auto* errors = new CpuStreamErrors();
+  return *errors;
+}
+
+void record_cpu_stream_error(int index, std::shared_ptr<std::string> error) {
+  auto& errors = cpu_stream_errors();
+  std::lock_guard<std::mutex> lock(errors.mutex);
+  if (error == errors.last_reported.lock()) {
+    return;
+  }
+  // Keep the earliest error.
+  errors.pending.try_emplace(index, std::move(error));
+}
+
+std::shared_ptr<std::string> pending_cpu_stream_error(int index) {
+  auto& errors = cpu_stream_errors();
+  std::lock_guard<std::mutex> lock(errors.mutex);
+  auto it = errors.pending.find(index);
+  return it == errors.pending.end() ? nullptr : it->second;
+}
+
+} // namespace
+
+void clear_reported_cpu_stream_error(
+    const std::shared_ptr<std::string>& reported) {
+  auto& errors = cpu_stream_errors();
+  std::lock_guard<std::mutex> lock(errors.mutex);
+  errors.last_reported = reported;
+  for (auto it = errors.pending.begin(); it != errors.pending.end();) {
+    if (it->second == reported) {
+      it = errors.pending.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
