+// Per-reader ownership: lazy Load primitives and their queued reads retain this state.
+// Events: 0=begin active reads, 1=successful bytes, 2=all current reads idle.
+class ReadProgress {
+ public:
+  using Callback = std::function<void(uint64_t, uint64_t, int)>;
+  using Capture = std::function<std::shared_ptr<ReadProgress>()>;
+  ReadProgress(uint64_t total, Callback callback, Capture capture = {})
+      : total_(total), callback_(std::move(callback)), capture_(std::move(capture)) {}
+  std::shared_ptr<ReadProgress> capture() const {
+    return capture_ ? capture_() : nullptr;
+  }
+  void begin() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (active_++ == 0) callback_(0, total_, 0);
+  }
+  void advance(uint64_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    callback_(bytes, total_, 1);
+  }
+  void end() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (--active_ == 0) callback_(0, total_, 2);
+  }
+  struct Scope {
+    std::shared_ptr<ReadProgress> progress;
+    explicit Scope(std::shared_ptr<ReadProgress> p) : progress(std::move(p)) {
+      if (progress) progress->begin();
+    }
+    ~Scope() { if (progress) progress->end(); }
+  };
+ private:
+  uint64_t total_;
+  Callback callback_;
+  Capture capture_;
+  std::mutex mutex_;
+  size_t active_{0};
+};
