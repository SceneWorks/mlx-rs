diff --git a/mlx/load_completion.h b/mlx/load_completion.h
new file mode 100644
index 0000000..311e734
--- /dev/null
+++ b/mlx/load_completion.h
@@ -0,0 +1,71 @@
+// Copyright © 2026 SceneWorks. MIT license.
+#pragma once
+
+#include <algorithm>
+#include <exception>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace mlx::core {
+
+// A load failure belongs to its evaluated arrays, not a process-global error
+// slot. Keep it across graph detachment and repeated waits, including when an
+// async result becomes an input to another evaluation. No array is retained.
+class LoadCompletion {
+ public:
+  void add(std::shared_future<void> load) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    loads_.push_back(std::move(load));
+  }
+
+  void depend_on(const std::shared_ptr<LoadCompletion>& parent) {
+    if (!parent || parent.get() == this) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (std::find(parents_.begin(), parents_.end(), parent) == parents_.end()) {
+      parents_.push_back(parent);
+    }
+  }
+
+  void wait() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Drain every outstanding read before surfacing an error: its destination
+    // must remain alive even if another read in the same evaluation failed.
+    for (auto& parent : parents_) {
+      try {
+        parent->wait();
+      } catch (...) {
+        if (!error_) {
+          error_ = std::current_exception();
+        }
+      }
+    }
+    for (auto& load : loads_) {
+      try {
+        load.get();
+      } catch (...) {
+        if (!error_) {
+          error_ = std::current_exception();
+        }
+      }
+    }
+    // Successful evaluations do not keep an ever-growing dependency history.
+    // A failed evaluation retains only the exception, so every alias refuses.
+    parents_.clear();
+    loads_.clear();
+    if (error_) {
+      std::rethrow_exception(error_);
+    }
+  }
+
+ private:
+  std::mutex mutex_;
+  std::vector<std::shared_future<void>> loads_;
+  std::vector<std::shared_ptr<LoadCompletion>> parents_;
+  std::exception_ptr error_;
+};
+
+} // namespace mlx::core
