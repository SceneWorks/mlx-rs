+// pmetal (sc-24245): evaluate only the not-yet-scheduled safetensors `Load`
+// leaves of `outputs`' lazy graphs, never a derived node. MLX runs `Load` on
+// its CPU stream (io thread pool); evaluating a GPU-stream consumer of an
+// unread `Load` makes the Metal command buffer wait on the disk read, which a
+// slow drive can hold past the GPU watchdog. Reading the pending loads first
+// leaves the later GPU evaluation with resident inputs only. The walk stops at
+// any node that is already scheduled or available; no pending loads is a
+// no-op.
+extern "C" int mlx_pmetal_eval_pending_loads(const mlx_vector_array outputs) {
+  try {
+    const auto& roots = mlx_vector_array_get_(outputs);
+    std::vector<mlx::core::array> loads;
+    std::unordered_set<std::uintptr_t> visited;
+    std::vector<mlx::core::array> stack(roots.begin(), roots.end());
+    while (!stack.empty()) {
+      auto a = std::move(stack.back());
+      stack.pop_back();
+      if (a.status() != mlx::core::array::Status::unscheduled ||
+          !a.has_primitive() || !visited.insert(a.id()).second) {
+        continue;
+      }
+      if (typeid(a.primitive()) == typeid(mlx::core::Load)) {
+        loads.push_back(std::move(a));
+        continue;
+      }
+      // Siblings share this node's primitive and inputs, so walking the inputs
+      // once covers every output of a multi-output primitive.
+      for (const auto& in : a.inputs()) {
+        stack.push_back(in);
+      }
+    }
+    mlx::core::eval(std::move(loads));
   } catch (std::exception& e) {
     mlx_error(e.what());
     return 1;
