From 236dc217b221453b896d9b1faee712b8c4782d58 Mon Sep 17 00:00:00 2001
From: Michael Trefry <michael@trefry.net>
Date: Wed, 12 Aug 2026 23:09:08 -0400
Subject: [PATCH] feat(ops): expose exact convolution bias bridge

Signed-off-by: Michael Trefry <michael@trefry.net>

diff --git a/mlx/c/ops.cpp b/mlx/c/ops.cpp
index 2090c32..974e536 100644
--- a/mlx/c/ops.cpp
+++ b/mlx/c/ops.cpp
@@ -847,6 +847,47 @@ extern "C" int mlx_conv_general(
   }
   return 0;
 }
+extern "C" int mlx_pmetal_conv_general_bias(
+    mlx_array* res,
+    const mlx_array input,
+    const mlx_array weight,
+    const mlx_array output_bias,
+    const int* stride,
+    size_t stride_num,
+    const int* padding_lo,
+    size_t padding_lo_num,
+    const int* padding_hi,
+    size_t padding_hi_num,
+    const int* kernel_dilation,
+    size_t kernel_dilation_num,
+    const int* input_dilation,
+    size_t input_dilation_num,
+    int groups,
+    bool flip,
+    const mlx_stream s) {
+  try {
+    mlx_array_set_(
+        *res,
+        mlx::core::conv_general_bias(
+            mlx_array_get_(input),
+            mlx_array_get_(weight),
+            mlx_array_get_(output_bias),
+            std::vector<int>(stride, stride + stride_num),
+            std::vector<int>(padding_lo, padding_lo + padding_lo_num),
+            std::vector<int>(padding_hi, padding_hi + padding_hi_num),
+            std::vector<int>(
+                kernel_dilation, kernel_dilation + kernel_dilation_num),
+            std::vector<int>(
+                input_dilation, input_dilation + input_dilation_num),
+            groups,
+            flip,
+            mlx_stream_get_(s)));
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
 extern "C" int mlx_conv_transpose1d(
     mlx_array* res,
     const mlx_array input,
diff --git a/mlx/c/ops.h b/mlx/c/ops.h
index 61e9a4a..2c899d4 100644
--- a/mlx/c/ops.h
+++ b/mlx/c/ops.h
@@ -278,6 +278,24 @@ int mlx_conv_general(
     int groups,
     bool flip,
     const mlx_stream s);
+int mlx_pmetal_conv_general_bias(
+    mlx_array* res,
+    const mlx_array input,
+    const mlx_array weight,
+    const mlx_array output_bias,
+    const int* stride,
+    size_t stride_num,
+    const int* padding_lo,
+    size_t padding_lo_num,
+    const int* padding_hi,
+    size_t padding_hi_num,
+    const int* kernel_dilation,
+    size_t kernel_dilation_num,
+    const int* input_dilation,
+    size_t input_dilation_num,
+    int groups,
+    bool flip,
+    const mlx_stream s);
 int mlx_conv_transpose1d(
     mlx_array* res,
     const mlx_array input,
