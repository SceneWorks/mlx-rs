+TEST_CASE("completion retirement resolves CPU setup failure behind unsubmitted mixed producers") {
+  auto producer = new_stream(Device::gpu);
+  auto middle_cpu = new_stream(Device::cpu);
+  auto middle_gpu = new_stream(Device::gpu);
+  auto consumer = new_stream(Device::cpu);
