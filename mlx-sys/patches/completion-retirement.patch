+  CHECK_NOTHROW(synchronize_and_retire(s));
+  CHECK(input_data.expired());
+  CHECK(output_data.expired());
+  auto clean = add(array(2.0f), array(3.0f), s);
+  CHECK_NOTHROW(eval(clean));
+  CHECK(clean.item<float>() == 5.0f);
+  CHECK_NOTHROW(synchronize_and_retire(s));
+}
