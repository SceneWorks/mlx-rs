+#include "mlx/backend/gpu/eval.h"
+
+using namespace mlx::core;
+using namespace std::chrono_literals;
+
+namespace {
+struct RetirementDrop {
+  std::promise<void>* entered;
+  std::shared_future<void> release;
+  std::atomic<int>* drops;
+  ~RetirementDrop() {
+    entered->set_value();
+    release.wait();
+    ++*drops;
+  }
+};
+
+class PartialCopy : public UnaryPrimitive {
+ public:
+  explicit PartialCopy(Stream stream, Event gate = {}) : UnaryPrimitive(stream), gate_(std::move(gate)) {}
+  const char* name() const override { return "PartialCopy"; }
+  void eval_cpu(const std::vector<array>&, array&) override { throw std::runtime_error("Metal test only"); }
+  void eval_gpu(const std::vector<array>& inputs, array& out) override {
+    out.set_data(allocator::malloc(out.nbytes()));
+    if (gate_.valid()) gate_.wait(stream());
+    copy_gpu_inplace(inputs[0], out, CopyType::Vector, stream());
+    throw std::runtime_error("synthetic partial encoding failure");
+  }
+ private:
+  Event gate_;
+};
+}
+
+TEST_CASE("completion retirement joins owner destructor with retained Metal block") {
+  auto s = new_stream(Device::gpu);
+  std::promise<void> entered, release;
+  auto entered_future = entered.get_future();
+  std::atomic<int> drops{0};
+  auto token = std::make_shared<RetirementDrop>();
+  token->entered = &entered;
+  token->release = release.get_future().share();
+  token->drops = &drops;
+  std::weak_ptr<RetirementDrop> weak = token;
+  NS::SharedPtr<MTL::CommandBuffer> retained;
+  {
+    std::lock_guard<std::recursive_mutex> lock(detail::eval_mutex());
+    auto& encoder = metal::get_command_encoder(s);
+    retained = NS::RetainPtr(encoder.get_command_buffer());
+    encoder.add_completed_handler([token = std::move(token)](MTL::CommandBuffer*) {});
+  }
+  // An actual submitted kernel, not merely a mocked completion flag.
+  auto out = add(array(1.0f), array(2.0f), s);
+  async_eval({out});
+  auto fence = std::async(std::launch::async, [s] { synchronize_and_retire(s); });
+  bool entered_in_time = entered_future.wait_for(10s) == std::future_status::ready;
+  bool blocked = entered_in_time && fence.wait_for(100ms) == std::future_status::timeout;
+  release.set_value(); // always unblock before assertions, including mutation failures
+  fence.get();
+  CHECK(entered_in_time);
+  CHECK(blocked);
+  CHECK(weak.expired());
+  CHECK(drops == 1);
+  CHECK(retained.get() != nullptr); // original MTL buffer/handler copies still retained
+  CHECK(out.item<float>() == 3.0f);
+  CHECK_NOTHROW(synchronize_and_retire(s));
+}
+
+TEST_CASE("completion retirement releases real eval inputs siblings and temporaries") {
+  auto s = new_stream(Device::gpu);
+  std::weak_ptr<array::Data> input_data, temporary_data;
+  array out(0.0f);
+  {
+    auto input = arange(0, 32, float32, s);
+    eval(input);
+    input_data = input.data_shared_ptr();
+    auto siblings = divmod(input, full({32}, 3.0f, float32, s), s);
+    out = add(siblings[0], siblings[1], s);
+    async_eval({out});
+  }
+  {
+    // Exercise end_encoding's temporary owner (not merely a custom callback).
+    std::lock_guard<std::recursive_mutex> lock(detail::eval_mutex());
