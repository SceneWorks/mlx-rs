diff --git a/mlx/backend/cpu/deferred_outcome.h b/mlx/backend/cpu/deferred_outcome.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/cpu/deferred_outcome.h
@@ -0,0 +1,48 @@
+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include <memory>
+#include <optional>
+#include <type_traits>
+#include <vector>
+#include "mlx/backend/cpu/task_outcome.h"
+
+namespace mlx::core::cpu {
+
+// Storage is allocated with the primitive outcome BEFORE any raw-pointer task is
+// queued. Only a failed setup populates it, so success-path donation is unchanged.
+// This is error custody for existing owners, not allocation admission/accounting.
+template <typename Owner>
+struct DeferredOutcome : TaskOutcome {
+  static_assert(std::is_nothrow_copy_constructible_v<Owner>);
+  void retain(const Owner& value, std::vector<Owner>&& out,
+              std::vector<Owner>&& temps) noexcept {
+    root.emplace(value);
+    outputs = std::move(out);
+    temporaries = std::move(temps);
+  }
+  std::optional<Owner> root;
+  std::vector<Owner> outputs, temporaries;
+  std::shared_ptr<DeferredOutcome> next;
+};
+
+template <typename Owner>
+class DeferredOutcomes {
+ public:
+  using Node = DeferredOutcome<Owner>;
+  void defer(std::shared_ptr<Node> node) noexcept {
+    node->next = std::move(head_);
+    head_ = std::move(node);
+  }
+  // Caller has joined actual queued work, including submitted producer waits.
+  // Destruction (and any allocator free) completes BEFORE this method returns.
+  void release() noexcept {
+    while (head_) {
+      auto node = std::move(head_);
+      head_ = std::move(node->next);
+    }
+  }
+ private:
+  std::shared_ptr<Node> head_;
+};
+
+} // namespace mlx::core::cpu
