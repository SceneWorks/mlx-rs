+// Metal integration definitions. Run on hosted/nax-macos-2, NEVER local GPU.
+// MLX_MAX_OPS_PER_BUFFER=2 MLX_METAL_FAST_SYNCH=1 ./tests --test-case='*completion retirement*'
+#include <atomic>
