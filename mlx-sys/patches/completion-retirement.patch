+void finalize_for_retirement(Stream s) {
+  auto& encoder = metal::get_command_encoder(s);
+  // CPU-only calls must never submit blank Metal buffers or initialize a new
+  // default GPU stream. Only registered streams with already-encoded work count.
+  if (encoder.has_pending_work()) {
+    encoder.end_encoding();
+    encoder.commit();
+  }
+}
