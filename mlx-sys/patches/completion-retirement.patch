new file mode 100644
--- /dev/null
+++ b/mlx/retirement.h
@@ -0,0 +1,46 @@
+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include <exception>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <utility>
+
+namespace mlx::core {
+
+// An immutable receipt for a range whose native owners have ALREADY retired.
+// Creating it may block/throw setup errors. wait() observes the cached result and
+// acknowledges ONLY that completed range. Dropping without wait never acks.
+class RetirementFence {
+  struct State {
+    State(std::exception_ptr e, std::function<bool()> a)
+        : error(std::move(e)), acknowledge(std::move(a)) {}
+    std::exception_ptr error;
+    std::function<bool()> acknowledge;
+    std::once_flag observed;
+    bool acknowledged{false};
+  };
+ public:
+  RetirementFence() = default;
+  static RetirementFence completed(std::exception_ptr error,
+                                   std::function<bool()> acknowledge) {
+    RetirementFence fence;
+    fence.state_ = std::make_shared<State>(std::move(error), std::move(acknowledge));
+    return fence;
+  }
+  void wait() const {
+    if (!state_) throw std::logic_error("[retirement] Empty fence.");
+    std::call_once(state_->observed, [&] {
+      state_->acknowledged = state_->acknowledge();
+    });
+    if (!state_->acknowledged) {
+      throw std::logic_error("[retirement] Cannot acknowledge unretired obligations.");
+    }
+    if (state_->error) std::rethrow_exception(state_->error);
+  }
+ private:
+  std::shared_ptr<State> state_;
+};
+
+} // namespace mlx::core
diff --git a/mlx/backend/common/execution_outcome.h b/mlx/backend/common/execution_outcome.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/common/execution_outcome.h
@@ -0,0 +1,56 @@
+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include <exception>
+#include <future>
+#include <mutex>
+
+namespace mlx::core::detail {
+
+// One CPU primitive's queued execution, retained by its output completion DAG.
+// The future contains no array/Data owner. It remains failed for every alias and
+// downstream CPU/Metal consumer, independently of stream retirement bookkeeping.
+class ExecutionOutcome {
+ public:
+  ExecutionOutcome() : future_(promise_.get_future().share()) {}
+
+  std::shared_future<void> future() const { return future_; }
+
+  void record_error(std::exception_ptr error) noexcept {
+    std::lock_guard lock(mutex_);
+    if (!static_cast<bool>(error_)) error_ = std::move(error);
+  }
+
+  std::exception_ptr error() noexcept {
+    std::lock_guard lock(mutex_);
+    return error_;
+  }
+
+  template <typename Task>
+  std::exception_ptr run(Task& task) noexcept {
+    // Do not cancel already queued work on a host encoding exception. Its raw
+    // input/output pointers remain valid until the queued owner-release closure.
+    try { task(); } catch (...) { record_error(std::current_exception()); }
+    std::lock_guard lock(mutex_);
+    return error_;
+  }
+
+  // Normally queued after this primitive's tasks. A setup failure may publish
+  // an invalid result earlier ONLY while DeferredOutcomes owns its whole graph
+  // until actual queue retirement. Readiness is never a release certificate.
+  void finish() noexcept {
+    std::lock_guard lock(mutex_);
+    if (finished_) return;
+    if (error_) promise_.set_exception(error_);
+    else promise_.set_value();
+    finished_ = true;
+  }
+
+ private:
+  std::promise<void> promise_;
+  std::shared_future<void> future_;
+  std::mutex mutex_;
+  std::exception_ptr error_;
+  bool finished_{false};
+};
+
+} // namespace mlx::core::detail
diff --git a/mlx/backend/metal/completion_retirement.h b/mlx/backend/metal/completion_retirement.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/completion_retirement.h
@@ -0,0 +1,198 @@
+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include <condition_variable>
+#include <cstdint>
+#include <exception>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+#include "mlx/retirement.h"
+
+namespace mlx::core::metal {
+
+// Host-only callback ownership/range journal (also used by CPU StreamThread).
+// No entry owns arrays. Entry allocation happens before work is published;
+// callback error recording, completion and acknowledgement do not allocate.
+class CompletionRetirement : public std::enable_shared_from_this<CompletionRetirement> {
+ public:
+  using Ticket = uint64_t;
+  enum class Kind { Execution, Callback };
+  template <typename Argument> class Callback;
+  class Record {
+   public:
+    explicit Record(std::shared_ptr<CompletionRetirement> state) : state_(std::move(state)) {}
+    ~Record() { if (ticket_) state_->cancel_reserved(ticket_); }
+    void error(std::exception_ptr error, Kind kind = Kind::Callback,
+               std::shared_ptr<std::string> key = {}) noexcept {
+      state_->record_error(ticket_, std::move(error), kind, std::move(key));
+    }
+   private:
+    friend class CompletionRetirement;
+    template <typename> friend class Callback;
+    std::shared_ptr<CompletionRetirement> state_;
+    Ticket ticket_{0};
+  };
+
+  template <typename Argument>
+  class Callback {
+   public:
+    Callback(std::shared_ptr<Record> record, std::function<void(Argument)> body)
+        : record_(std::move(record)), body_(std::move(body)) {}
+    void run(Argument argument) noexcept {
+      std::call_once(once_, [this, argument] {
+        try { body_(argument); }
+        catch (...) { record_->error(std::current_exception()); }
+        body_ = nullptr; // owner destruction BEFORE completion publication
+        record_->state_->finish(record_->ticket_);
+      });
+    }
+    // Only for a task which failed to enter its queue; never for scheduled work.
+    void cancel_unpublished() noexcept {
+      std::call_once(once_, [this] {
+        body_ = nullptr;
+        record_->state_->finish(record_->ticket_);
+      });
+    }
+   private:
+    std::shared_ptr<Record> record_;
+    std::function<void(Argument)> body_;
+    std::once_flag once_;
+  };
+
+  std::shared_ptr<Record> prepare() {
+    auto record = std::make_shared<Record>(shared_from_this());
+    std::lock_guard lock(mutex_);
+    Ticket ticket = issued_ + 1;
+    entries_.try_emplace(ticket);
+    issued_ = ticket;
+    record->ticket_ = ticket;
+    return record;
+  }
+
+  template <typename Argument>
+  std::shared_ptr<Callback<Argument>> track(std::function<void(Argument)> body,
+                                          std::shared_ptr<Record> record = {}) {
+    if (!record) record = prepare();
+    auto callback = std::make_shared<Callback<Argument>>(record, std::move(body));
+    {
+      std::lock_guard lock(mutex_);
+      auto it = entries_.find(record->ticket_);
+      if (record->state_.get() != this || it == entries_.end() || it->second.status != Status::Reserved) {
+        throw std::logic_error("[retirement] Invalid callback record.");
+      }
+      it->second.status = Status::Pending;
+    }
+    return callback;
+  }
+
+  Ticket snapshot() const { std::lock_guard lock(mutex_); return issued_; }
+  void wait(Ticket through) {
+    std::unique_lock lock(mutex_);
+    ready_.wait(lock, [&] { return complete_locked(through); });
+  }
+  std::exception_ptr error_through(Ticket through) const {
+    std::lock_guard lock(mutex_);
+    for (auto& [ticket, entry] : entries_) {
+      if (ticket > through) break;
+      if (!entry.acknowledged && entry.error) return entry.error;
+    }
+    return {};
+  }
+  std::vector<std::shared_ptr<std::string>> keys_through(Ticket through) const {
+    std::vector<std::shared_ptr<std::string>> keys;
+    std::lock_guard lock(mutex_);
+    for (auto& [ticket, entry] : entries_) {
+      if (ticket > through) break;
+      if (!entry.acknowledged && entry.key) keys.push_back(entry.key);
+    }
+    return keys;
+  }
+  bool acknowledge(Ticket through) noexcept {
+    std::lock_guard lock(mutex_);
+    if (!complete_locked(through)) return false;
+    auto end = entries_.upper_bound(through);
+    entries_.erase(entries_.begin(), end);
+    return true;
+  }
+  // An ordinary array/event error report acknowledges only that execution
+  // failure. A callback/retirement failure always requires an observed fence.
+  void acknowledge_execution(const std::shared_ptr<std::string>& key) noexcept {
+    std::lock_guard lock(mutex_);
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      auto& entry = it->second;
+      if (entry.kind == Kind::Execution && entry.key == key) {
+        entry.acknowledged = true;
+        if (entry.status == Status::Complete) { it = entries_.erase(it); continue; }
+      }
+      ++it;
+    }
+  }
+  mlx::core::RetirementFence fence() {
+    auto through = snapshot();
+    wait(through);
+    auto error = error_through(through);
+    return mlx::core::RetirementFence::completed(error,
+        [state = shared_from_this(), through]() noexcept { return state->acknowledge(through); });
+  }
+
+ private:
+  enum class Status { Reserved, Pending, Complete };
+  struct Entry {
+    Status status{Status::Reserved};
+    Kind kind{Kind::Callback};
+    bool acknowledged{false};
+    std::exception_ptr error;
+    std::shared_ptr<std::string> key;
+  };
+  bool complete_locked(Ticket through) const noexcept {
+    for (auto& [ticket, entry] : entries_) {
+      if (ticket > through) break;
+      if (entry.status != Status::Complete) return false;
+    }
+    return true;
+  }
+  void record_error(Ticket ticket, std::exception_ptr error, Kind kind,
+                    std::shared_ptr<std::string> key) noexcept {
+    std::lock_guard lock(mutex_);
+    auto it = entries_.find(ticket);
+    if (it == entries_.end() || it->second.status != Status::Pending) return;
+    auto& entry = it->second;
+    // Callback failure upgrades an acknowledged execution report. It cannot
+    // disappear merely because ordinary eval consumed the transport error.
+    if (!entry.error || (entry.kind == Kind::Execution && kind == Kind::Callback)) {
+      entry.error = std::move(error);
+      entry.kind = kind;
+      entry.key = std::move(key);
+      entry.acknowledged = false;
+    }
+  }
+  void finish(Ticket ticket) noexcept {
+    {
+      std::lock_guard lock(mutex_);
+      auto it = entries_.find(ticket);
+      if (it != entries_.end()) {
+        it->second.status = Status::Complete;
+        if (!it->second.error || it->second.acknowledged) entries_.erase(it);
+      }
+    }
+    ready_.notify_all();
+  }
+  void cancel_reserved(Ticket ticket) noexcept {
+    {
+      std::lock_guard lock(mutex_);
+      auto it = entries_.find(ticket);
+      if (it != entries_.end() && it->second.status == Status::Reserved) entries_.erase(it);
+    }
+    ready_.notify_all();
+  }
+  mutable std::mutex mutex_;
+  std::condition_variable ready_;
+  Ticket issued_{0};
+  std::map<Ticket, Entry> entries_;
+};
+
+} // namespace mlx::core::metal
diff --git a/mlx/backend/metal/commit_completion.h b/mlx/backend/metal/commit_completion.h
new file mode 100644
--- /dev/null
+++ b/mlx/backend/metal/commit_completion.h
@@ -0,0 +1,22 @@
+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include <exception>
+#include <type_traits>
+#include <utility>
+
+namespace mlx::core::metal {
+
+// The production commit callback uses this boundary: throwing work/accounting
+// cannot bypass no-allocation event/debug finalization. Error handling and the
+// finalizer MUST be noexcept; exceptions never cross Metal's callback ABI.
+template <typename Body, typename Completion, typename Finalize, typename OnError>
+void run_commit_completion(Body&& body, Completion&& completion,
+                           Finalize&& finalize, OnError&& on_error) noexcept {
+  static_assert(std::is_nothrow_invocable_v<Finalize>);
+  static_assert(std::is_nothrow_invocable_v<OnError, std::exception_ptr>);
+  try { body(); } catch (...) { on_error(std::current_exception()); }
+  try { completion(); } catch (...) { on_error(std::current_exception()); }
+  finalize();
+}
+
+} // namespace mlx::core::metal
