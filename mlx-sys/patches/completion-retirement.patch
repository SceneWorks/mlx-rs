+  NS::SharedPtr<MTL::CommandBuffer> first_unsubmitted, unsubmitted;
+  std::weak_ptr<array::Data> first_data, middle_data, input_data, output_data;
+  float* ptr = nullptr;
+  std::promise<bool> copied;
+  auto observed = copied.get_future();
+  {
+    // Materialize equal-shaped constants BEFORE arming the hook: there are
+    // exactly two CPU primitives in the actual GPU -> CPU -> GPU -> CPU graph.
+    auto one = full({32}, 1.0f, float32, Device::cpu);
+    auto two = full({32}, 2.0f, float32, Device::cpu);
+    auto three = full({32}, 3.0f, float32, Device::cpu);
+    eval(one, two, three);
+    auto first = arange(0, 32, float32, producer);
+    auto middle = add(first, one, middle_cpu);
+    auto input = add(middle, two, middle_gpu);
+    auto out = add(input, three, consumer);
+    mlx_pmetal_test_fail_cpu_completion_setup_after(1);
+    CHECK_THROWS_AS(eval(out), std::bad_alloc);
+    CHECK(first_encoder.has_pending_work());
+    CHECK(gpu_encoder.has_pending_work());
+    first_unsubmitted = NS::RetainPtr(first_encoder.get_command_buffer());
+    unsubmitted = NS::RetainPtr(gpu_encoder.get_command_buffer());
+    first_data = first.data_shared_ptr();
+    middle_data = middle.data_shared_ptr();
+    input_data = input.data_shared_ptr();
+    output_data = out.data_shared_ptr();
+    CHECK(out.data_shared_ptr() != input.data_shared_ptr());
+    ptr = out.data<float>();
+    // The parent's CPU outcome is still pending behind an unsubmitted GPU
+    // producer. Failed-setup refusal must not wait on that parent future.
+    CHECK_THROWS_AS(out.wait(), std::bad_alloc);
+    auto refused = add(out, three, consumer);
+    CHECK_THROWS_AS(eval(refused), std::bad_alloc);
+  }
+  CHECK(first_encoder.get_command_buffer() == first_unsubmitted.get());
+  CHECK(gpu_encoder.get_command_buffer() == unsubmitted.get());
+  CHECK_FALSE(first_data.expired());
+  CHECK_FALSE(middle_data.expired());
+  CHECK_FALSE(input_data.expired());
+  CHECK_FALSE(output_data.expired());
+  auto owner = output_data.lock();
+  scheduler::enqueue(consumer, [owner = std::move(owner), ptr, &copied] {
+    copied.set_value(owner && ptr[0] == 6.0f && ptr[31] == 37.0f);
+  });
+  CHECK_NOTHROW(synchronize_and_retire(consumer));
+  CHECK_NOTHROW(synchronize_and_retire(producer));
+  CHECK_NOTHROW(synchronize_and_retire(middle_cpu));
+  CHECK_NOTHROW(synchronize_and_retire(middle_gpu));
+  CHECK(observed.get());
+  CHECK(first_data.expired());
+  CHECK(middle_data.expired());
+  CHECK(input_data.expired());
+  CHECK(output_data.expired());
+}
