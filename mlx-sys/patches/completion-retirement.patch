+  auto owner = output_data.lock();
+  metal::get_command_encoder(s).add_completed_handler(
+      [owner = std::move(owner), ptr, &copied](MTL::CommandBuffer*) {
+        if (owner && ptr[0] == 1.0f && ptr[1] == 2.0f && ptr[2] == 3.0f) copied.set_value();
