+// Copyright © 2026 pmetal contributors.
+#pragma once
+#include "mlx/retirement.h"
+namespace mlx::core::detail {
+// Submission can add owner callbacks. Capture MUST run afterward. No catch:
+// failed submission/join cannot manufacture a completed receipt or acknowledge.
+template <typename Submit, typename Capture>
+RetirementFence capture_retirement_range(Submit&& submit, Capture&& capture) {
+  submit();
+  return capture();
+}
+}
