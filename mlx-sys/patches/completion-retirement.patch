+class CpuPartialCopy : public UnaryPrimitive {
+ public:
+  CpuPartialCopy(Stream s, std::shared_future<void> gate) : UnaryPrimitive(s), gate_(std::move(gate)) {}
+  const char* name() const override { return "CpuPartialCopy"; }
+  void eval_gpu(const std::vector<array>&, array&) override { throw std::runtime_error("CPU test only"); }
+  void eval_cpu(const std::vector<array>& inputs, array& out) override {
+    out.set_data(allocator::malloc(out.nbytes()));
+    cpu::get_command_encoder(stream()).dispatch([gate = gate_] { gate.wait(); });
+    copy_cpu_inplace(inputs[0], out, CopyType::Vector, stream());
+    throw std::runtime_error("synthetic partial CPU encoding failure");
+  }
+ private:
+  std::shared_future<void> gate_;
+};
+class CpuTaskFailure : public UnaryPrimitive {
+ public:
+  explicit CpuTaskFailure(Stream s) : UnaryPrimitive(s) {}
+  const char* name() const override { return "CpuTaskFailure"; }
+  void eval_gpu(const std::vector<array>&, array&) override { throw std::runtime_error("CPU test only"); }
+  void eval_cpu(const std::vector<array>&, array& out) override {
+    out.set_data(allocator::malloc(out.nbytes()));
+    cpu::get_command_encoder(stream()).dispatch([ptr = out.data<float>(), n = out.size()] {
+      std::fill_n(ptr, n, 1.0f);
+      throw std::runtime_error("synthetic CPU primitive task failure");
+    });
+  }
+};
+class CpuLoadFailure : public UnaryPrimitive {
+ public:
+  explicit CpuLoadFailure(Stream s) : UnaryPrimitive(s) {}
+  const char* name() const override { return "CpuLoadFailure"; }
+  void eval_gpu(const std::vector<array>&, array&) override { throw std::runtime_error("CPU test only"); }
+  void eval_cpu(const std::vector<array>&, array& out) override {
+    out.set_data(allocator::malloc(out.nbytes()));
+    std::promise<void> promise;
+    auto completion = std::make_shared<LoadCompletion>();
+    completion->add(promise.get_future().share());
+    promise.set_exception(std::make_exception_ptr(std::runtime_error("synthetic CPU read failure")));
+    out.attach_load_completion(std::move(completion));
