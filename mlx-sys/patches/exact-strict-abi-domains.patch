   }
+  constexpr size_t max_qmm_dim = INT_MAX - 63;
+  if (static_cast<size_t>(w_inner_dims) > max_qmm_dim ||
+      static_cast<size_t>(w_outer_dims) > max_qmm_dim) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] N and K must fit the Metal int launch ABI; "
+        "use the eager fallback.");
+  }
 
   // Mirror ensure_row_contiguous_matrix + QuantizedMatmul::eval_gpu when
   // deriving M/B. A view whose last two dimensions are already contiguous
   // preserves its leading batch strides, while every other view is copied to
   // one row-contiguous matrix and collapsed across its leading dimensions.
+  //
+  // Unscheduled MLX arrays carry provisional contiguous flags even when a
+  // view primitive (for example Broadcast) will replace them at evaluation.
+  // AsType's vector-copy path can preserve those eventual strides even when
+  // the dtype changes. Conservatively require both possible aggregate and
+  // batch-strided interpretations for every unscheduled stored input;
+  // materialized inputs use their final flags exactly.
   auto x_cast = astype(x, dtype);
-  bool matrix_contiguous = false;
-  if (x_cast.ndim() < 2) {
-    matrix_contiguous = x_cast.strides()[0] == 1;
-  } else {
-    matrix_contiguous =
+  enum class DispatchRejection { None, M, Batch, Tiles };
+  auto dispatch_rejection = [&](bool row_contiguous) {
+    const size_t M_size = row_contiguous
+        ? x_cast.size() / static_cast<size_t>(w_inner_dims)
+        : static_cast<size_t>(x_cast.shape(-2));
+
+    // The eager baseline selects qmm only above the device-dependent vector
+    // threshold (never greater than 32). For B == 1 it first selects split-K,
+    // which delegates to qmm exactly at 512 or more 32x32 output tiles;
+    // batched inputs route directly to qmm and do not need that tile bound.
+    if (M_size < 32 || M_size > max_qmm_dim) {
+      return DispatchRejection::M;
+    }
+    const size_t B_size =
+        x_cast.size() / M_size / static_cast<size_t>(w_inner_dims);
+    if (B_size == 0 || B_size > INT_MAX) {
+      return DispatchRejection::Batch;
+    }
+    const size_t tile_count = ((M_size + 31) / 32) *
+        ((static_cast<size_t>(w_outer_dims) + 31) / 32);
+    if (B_size == 1 && (tile_count < 512 || tile_count > INT_MAX)) {
+      return DispatchRejection::Tiles;
+    }
+    return DispatchRejection::None;
+  };
+
+  DispatchRejection rejection;
+  if (x_cast.ndim() <= 2) {
+    rejection = dispatch_rejection(true);
+  } else if (x_cast.status() != array::unscheduled) {
+    const bool matrix_contiguous =
         x_cast.strides()[x_cast.ndim() - 2] == x_cast.shape(-1) &&
         x_cast.strides()[x_cast.ndim() - 1] == 1;
+    rejection = dispatch_rejection(
+        !matrix_contiguous || x_cast.flags().row_contiguous);
+  } else {
+    const auto aggregate = dispatch_rejection(true);
+    const auto batched = dispatch_rejection(false);
+    if (aggregate == DispatchRejection::None &&
+        batched == DispatchRejection::None) {
+      rejection = DispatchRejection::None;
+    } else if (
+        aggregate == DispatchRejection::M ||
+        batched == DispatchRejection::M) {
+      rejection = DispatchRejection::M;
+    } else if (
+        aggregate == DispatchRejection::Batch ||
+        batched == DispatchRejection::Batch) {
+      rejection = DispatchRejection::Batch;
+    } else {
+      rejection = DispatchRejection::Tiles;
+    }
   }
-  const bool eval_row_contiguous =
-      matrix_contiguous ? x_cast.flags().row_contiguous : true;
-  int M = eval_row_contiguous ? x_cast.size() / w_inner_dims
-                              : x_cast.shape(-2);
 
-  // The eager baseline selects qmm only above the device-dependent vector
-  // threshold (never greater than 32). For B == 1 it first selects split-K,
-  // which delegates to qmm exactly at 512 or more 32x32 output tiles; batched
-  // inputs route directly to qmm and therefore do not need the tile condition.
-  if (M < 32) {
-    throw std::invalid_argument(
-        "[quantized_matmul_bias] Shape does not select the direct qmm path; "
-        "use the eager fallback.");
+  switch (rejection) {
+    case DispatchRejection::M:
+      throw std::invalid_argument(
+          "[quantized_matmul_bias] M does not select or fit the direct qmm "
+          "Metal ABI; use the eager fallback.");
+    case DispatchRejection::Batch:
+      throw std::invalid_argument(
+          "[quantized_matmul_bias] Batch count must fit the Metal int ABI; "
+          "use the eager fallback.");
+    case DispatchRejection::Tiles:
+      throw std::invalid_argument(
+          "[quantized_matmul_bias] Shape does not select or fit the direct "
+          "qmm path; use the eager fallback.");
+    case DispatchRejection::None:
+      break;
   }
-  int B = x_cast.size() / M / w_inner_dims;
-  int tile_count = ((M + 31) / 32) * ((w_outer_dims + 31) / 32);
-  if (B == 1 && tile_count < 512) {
+
+  auto stream = to_stream(s);
+  if (stream.device != Device::gpu || !metal::is_available()) {
     throw std::invalid_argument(
-        "[quantized_matmul_bias] Shape does not select the direct qmm path; "
-        "use the eager fallback.");
+        "[quantized_matmul_bias] The exact fused epilogue is Metal-only.");
   }
 
