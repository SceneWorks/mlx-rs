+    constexpr int64_t max_implicit_dim = INT_MAX - 63;
+    auto product_fits_implicit_dim = [max_implicit_dim](auto first, auto last) {
+      int64_t product = 1;
+      for (; first != last; ++first) {
+        if (*first <= 0 || product > max_implicit_dim / *first) {
+          return false;
+        }
+        product *= *first;
