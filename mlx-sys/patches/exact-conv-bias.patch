+++ b/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.metal
@@ -20,28 +20,35 @@
     channel_name,                                                              \
     n_channels,                                                                \
     filter_name,                                                               \
-    small_filter)                                                              \
+    small_filter,                                                              \
+    has_bias)                                                                  \
   template [[host_name("implicit_gemm_conv_2d_" #name "_bm" #bm "_bn" #bn      \
                        "_bk" #bk "_wm" #wm "_wn" #wn "_channel_" #channel_name \
-                       "_filter_" #filter_name)]] [[kernel]] void              \
-  implicit_gemm_conv_2d<itype, bm, bn, bk, wm, wn, n_channels, small_filter>(  \
+                       "_filter_" #filter_name "_bias_" #has_bias)]] [[kernel]] void \
+  implicit_gemm_conv_2d<                                                       \
+      itype, bm, bn, bk, wm, wn, n_channels, small_filter, has_bias>(          \
       const device itype* A [[buffer(0)]],                                     \
       const device itype* B [[buffer(1)]],                                     \
       device itype* C [[buffer(2)]],                                           \
       const constant MLXConvParams<2>* params [[buffer(3)]],                   \
       const constant ImplicitGemmConv2DParams* gemm_params [[buffer(4)]],      \
+      const device itype* output_bias [[buffer(5)]],                           \
       uint3 tid [[threadgroup_position_in_grid]],                              \
       uint3 lid [[thread_position_in_threadgroup]],                            \
       uint simd_gid [[simdgroup_index_in_threadgroup]],                        \
       uint simd_lid [[thread_index_in_simdgroup]]);
 
+#define instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, channel_name, n_channels, filter_name, small_filter) \
+    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, channel_name, n_channels, filter_name, small_filter, 0) \
+    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, channel_name, n_channels, filter_name, small_filter, 1)
+
 #define instantiate_implicit_2d_filter(name, itype, bm, bn, bk, wm, wn)           \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, l, 0, s, true)  \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, l, 0, l, false) \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, 1, 1, l, false) \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, 2, 2, l, false) \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, 3, 3, l, false) \
-    instantiate_implicit_conv_2d(name, itype, bm, bn, bk, wm, wn, 4, 4, l, false)
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, l, 0, s, true)  \
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, l, 0, l, false) \
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, 1, 1, l, false) \
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, 2, 2, l, false) \
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, 3, 3, l, false) \
+    instantiate_implicit_conv_2d_bias(name, itype, bm, bn, bk, wm, wn, 4, 4, l, false)
 
 #define instantiate_implicit_2d_blocks(name, itype)               \
     instantiate_implicit_2d_filter(name, itype, 32,  8, 16, 4, 1) \
