From a06937f6b4c90acdd7bc9a86d6093494865b0d2d Mon Sep 17 00:00:00 2001
From: Michael Trefry <michael@trefry.net>
Date: Wed, 12 Aug 2026 23:08:50 -0400
Subject: [PATCH] feat(convolution): add exact bias epilogues

Signed-off-by: Michael Trefry <michael@trefry.net>

diff --git a/mlx/backend/cpu/conv.cpp b/mlx/backend/cpu/conv.cpp
index 5d4638a..186e73a 100644
--- a/mlx/backend/cpu/conv.cpp
+++ b/mlx/backend/cpu/conv.cpp
@@ -1291,6 +1291,10 @@ void conv_3D_cpu(
 } // namespace
 
 void Convolution::eval_cpu(const std::vector<array>& inputs, array& out) {
+  if (output_bias_) {
+    throw std::runtime_error(
+        "[conv_general_bias] The exact fused epilogue is Metal-only.");
+  }
   out.set_data(allocator::malloc(out.nbytes()));
 
   auto& in = inputs[0];
diff --git a/mlx/backend/metal/conv.cpp b/mlx/backend/metal/conv.cpp
index 49f87d9..3b68564 100644
--- a/mlx/backend/metal/conv.cpp
+++ b/mlx/backend/metal/conv.cpp
@@ -194,7 +194,8 @@ void implicit_gemm_conv_2D_gpu(
     const array& in,
     const array& wt,
     array& out,
-    const MLXConvParams<2>& conv_params) {
+    const MLXConvParams<2>& conv_params,
+    const std::optional<array>& output_bias) {
   const int groups = conv_params.groups;
   const int C_per_group = conv_params.C / conv_params.groups;
   const int O_per_group = conv_params.O / conv_params.groups;
@@ -286,7 +287,9 @@ void implicit_gemm_conv_2D_gpu(
       "_channel_",
       n_channel_specialization ? std::to_string(n_channel_specialization) : "l",
       "_filter_",
-      small_filter ? 's' : 'l');
+      small_filter ? 's' : 'l',
+      "_bias_",
+      output_bias.has_value());
 
   // Encode and dispatch kernel
   auto& compute_encoder = metal::get_command_encoder(s);
@@ -300,7 +303,8 @@ void implicit_gemm_conv_2D_gpu(
       wm,
       wn,
       n_channel_specialization,
-      small_filter);
+      small_filter,
+      output_bias.has_value());
   compute_encoder.set_compute_pipeline_state(kernel);
 
   // Deduce grid launch dimensions
@@ -319,6 +323,7 @@ void implicit_gemm_conv_2D_gpu(
   // Encode params
   compute_encoder.set_bytes(conv_params, 3);
   compute_encoder.set_bytes(gemm_params, 4);
+  compute_encoder.set_input_array(output_bias ? *output_bias : out, 5);
 
   // Launch kernel
   compute_encoder.dispatch_threadgroups(grid_dims, group_dims);
@@ -330,7 +335,8 @@ void implicit_gemm_conv_2D_general_gpu(
     const array& in,
     const array& wt,
     array& out,
-    const MLXConvParams<2>& conv_params) {
+    const MLXConvParams<2>& conv_params,
+    const std::optional<array>& output_bias) {
   // Deduce implicit gemm size
   int implicit_M = safe_cast(
       static_cast<int64_t>(conv_params.N) * conv_params.oS[0] *
@@ -466,7 +472,9 @@ void implicit_gemm_conv_2D_general_gpu(
       "_wm",
       wm,
       "_wn",
-      wn);
+      wn,
+      "_bias_",
+      output_bias.has_value());
   std::string hash_name;
   hash_name.reserve(64);
   concatenate(hash_name, kname, "_alC_", align_C);
@@ -477,7 +485,17 @@ void implicit_gemm_conv_2D_general_gpu(
   // Encode and dispatch kernel
   auto& compute_encoder = metal::get_command_encoder(s);
   auto kernel = get_steel_conv_general_kernel(
-      d, kname, hash_name, func_consts, out, bm, bn, bk, wm, wn);
+      d,
+      kname,
+      hash_name,
+      func_consts,
+      out,
+      bm,
+      bn,
+      bk,
+      wm,
+      wn,
+      output_bias.has_value());
   compute_encoder.set_compute_pipeline_state(kernel);
 
   // Deduce grid launch dimensions
@@ -501,6 +519,7 @@ void implicit_gemm_conv_2D_general_gpu(
 
   compute_encoder.set_vector_bytes(base_h, 6);
   compute_encoder.set_vector_bytes(base_w, 7);
+  compute_encoder.set_input_array(output_bias ? *output_bias : out, 8);
 
   // Launch kernel
   compute_encoder.dispatch_threadgroups(grid_dims, group_dims);
@@ -512,7 +531,8 @@ void implicit_gemm_conv_3D_gpu(
     const array& in,
     const array& wt,
     array& out,
-    const MLXConvParams<3>& conv_params) {
+    const MLXConvParams<3>& conv_params,
+    const std::optional<array>& output_bias) {
   const int groups = conv_params.groups;
   const int C_per_group = conv_params.C / conv_params.groups;
   const int O_per_group = conv_params.O / conv_params.groups;
@@ -600,12 +620,23 @@ void implicit_gemm_conv_3D_gpu(
       "_wn",
       wn,
       "_filter_",
-      small_filter ? 's' : 'l');
+      small_filter ? 's' : 'l',
+      "_bias_",
+      output_bias.has_value());
 
   // Encode and dispatch kernel
   auto& compute_encoder = metal::get_command_encoder(s);
-  auto kernel =
-      get_steel_conv_3d_kernel(d, kname, out, bm, bn, bk, wm, wn, small_filter);
+  auto kernel = get_steel_conv_3d_kernel(
+      d,
+      kname,
+      out,
+      bm,
+      bn,
+      bk,
+      wm,
+      wn,
+      small_filter,
+      output_bias.has_value());
   compute_encoder.set_compute_pipeline_state(kernel);
 
   // Deduce grid launch dimensions
@@ -624,6 +655,7 @@ void implicit_gemm_conv_3D_gpu(
   // Encode params
   compute_encoder.set_bytes(conv_params, 3);
   compute_encoder.set_bytes(gemm_params, 4);
+  compute_encoder.set_input_array(output_bias ? *output_bias : out, 5);
 
   // Launch kernel
   compute_encoder.dispatch_threadgroups(grid_dims, group_dims);
@@ -669,7 +701,8 @@ void pad_and_slice_conv_3D_gpu(
   array wt = pad_array(wt_pre, extra_o, extra_c);
   auto new_params =
       MLXConvParams<3>::with_padded_channels(conv_params, extra_o, extra_c);
-  implicit_gemm_conv_3D_gpu(s, d, in, wt, intermediate, new_params);
+  implicit_gemm_conv_3D_gpu(
+      s, d, in, wt, intermediate, new_params, std::nullopt);
 
   // Slice out
   out.copy_shared_buffer(
@@ -683,7 +716,8 @@ void dispatch_conv_3D_gpu(
     const array& wt_pre,
     array& out,
     const MLXConvParams<3>& conv_params,
-    std::vector<array>& copies) {
+    std::vector<array>& copies,
+    const std::optional<array>& output_bias) {
   bool is_idil_one = conv_params.idil[0] == 1 && conv_params.idil[1] == 1 &&
       conv_params.idil[2] == 1;
   const int C_per_group = conv_params.C / conv_params.groups;
@@ -698,6 +732,10 @@ void dispatch_conv_3D_gpu(
   // We check it first because it doesn't need contiguous inputs and it needs
   // different output allocation.
   if (is_idil_one && !mod16_channels && conv_params.groups == 1) {
+    if (output_bias) {
+      throw std::runtime_error(
+          "[conv_general_bias] Padded 3D dispatch must use eager fallback.");
+    }
     return pad_and_slice_conv_3D_gpu(s, d, in_pre, wt_pre, out, conv_params);
   }
 
@@ -708,7 +746,13 @@ void dispatch_conv_3D_gpu(
 
   // Perform the implicit gemm
   if (is_idil_one && mod16_channels) {
-    return implicit_gemm_conv_3D_gpu(s, d, in, wt, out, conv_params);
+    return implicit_gemm_conv_3D_gpu(
+        s, d, in, wt, out, conv_params, output_bias);
+  }
+
+  if (output_bias) {
+    throw std::runtime_error(
+        "[conv_general_bias] Explicit 3D dispatch must use eager fallback.");
   }
 
   // Explicit gemms where we unfold and do a matmul
@@ -984,12 +1028,17 @@ void dispatch_conv_2D_gpu(
     const array& wt,
     array& out,
     const MLXConvParams<2>& conv_params,
-    std::vector<array>& copies) {
+    std::vector<array>& copies,
+    const std::optional<array>& output_bias) {
   bool is_stride_one = conv_params.str[0] == 1 && conv_params.str[1] == 1;
   bool is_kdil_one = conv_params.kdil[0] == 1 && conv_params.kdil[1] == 1;
   bool is_idil_one = conv_params.idil[0] == 1 && conv_params.idil[1] == 1;
 
   if (conv_params.groups > 1) {
+    if (output_bias) {
+      throw std::runtime_error(
+          "[conv_general_bias] Grouped 2D dispatch must use eager fallback.");
+    }
     const int C_per_group = conv_params.C / conv_params.groups;
     const int O_per_group = conv_params.O / conv_params.groups;
 
@@ -1007,7 +1056,8 @@ void dispatch_conv_2D_gpu(
 
     if ((C_per_group <= 4 || C_per_group % 16 == 0) &&
         (O_per_group <= 16 || O_per_group % 16 == 0)) {
-      return implicit_gemm_conv_2D_gpu(s, d, in, wt, out, conv_params);
+      return implicit_gemm_conv_2D_gpu(
+          s, d, in, wt, out, conv_params, std::nullopt);
     } else {
       return explicit_gemm_conv_group_ND_gpu(s, d, in, wt, out, conv_params);
     }
@@ -1023,21 +1073,31 @@ void dispatch_conv_2D_gpu(
       conv_params.wS[0] == 3 && conv_params.wS[1] == 3 &&
       conv_params.C % 32 == 0 && conv_params.O % 32 == 0 && inp_large &&
       channels_large) {
+    if (output_bias) {
+      throw std::runtime_error(
+          "[conv_general_bias] Winograd dispatch must use eager fallback.");
+    }
     return winograd_conv_2D_gpu(s, d, in, wt, out, conv_params, copies);
   }
 
   // Direct to implicit gemm conv
   if (is_idil_one && (conv_params.C <= 4 || conv_params.C % 16 == 0) &&
       (conv_params.O <= 16 || conv_params.O % 16 == 0)) {
-    return implicit_gemm_conv_2D_gpu(s, d, in, wt, out, conv_params);
+    return implicit_gemm_conv_2D_gpu(
+        s, d, in, wt, out, conv_params, output_bias);
   }
 
   else if ((conv_params.C % 16 == 0 && conv_params.O % 16 == 0) || out_large) {
-    return implicit_gemm_conv_2D_general_gpu(s, d, in, wt, out, conv_params);
+    return implicit_gemm_conv_2D_general_gpu(
+        s, d, in, wt, out, conv_params, output_bias);
   }
 
   // Direct to explicit gemm conv
   else {
+    if (output_bias) {
+      throw std::runtime_error(
+          "[conv_general_bias] Explicit 2D dispatch must use eager fallback.");
+    }
     return explicit_gemm_conv_ND_gpu(s, d, in, wt, out, conv_params);
   }
 }
@@ -1142,7 +1202,8 @@ void conv_1D_gpu(
         /* const int groups = */ groups,
         /* const bool flip = */ flip};
 
-    dispatch_conv_2D_gpu(s, d, in, wt, out, conv_params, copies);
+    dispatch_conv_2D_gpu(
+        s, d, in, wt, out, conv_params, copies, std::nullopt);
     return;
   }
 
@@ -1187,7 +1248,8 @@ void conv_2D_gpu(
     const std::vector<int>& in_dilation,
     const int groups,
     bool flip,
-    std::vector<array>& copies) {
+    std::vector<array>& copies,
+    const std::optional<array>& output_bias) {
   // Allocate space and ensure weights are contiguous
   out.set_data(allocator::malloc(out.nbytes()));
   auto in = ensure_row_contiguous(in_pre, d, s);
@@ -1217,7 +1279,8 @@ void conv_2D_gpu(
       /* const int groups = */ groups,
       /* const bool flip = */ flip,
   };
-  dispatch_conv_2D_gpu(s, d, in, wt, out, conv_params, copies);
+  dispatch_conv_2D_gpu(
+      s, d, in, wt, out, conv_params, copies, output_bias);
 }
 
 void conv_3D_gpu(
@@ -1232,7 +1295,8 @@ void conv_3D_gpu(
     const std::vector<int>& in_dilation,
     int groups,
     bool flip,
-    std::vector<array>& copies) {
+    std::vector<array>& copies,
+    const std::optional<array>& output_bias) {
   // We will use the contiguous strides for the conv params because that is
   // what the rest of the code expects.
   constexpr int NDIM = 3;
@@ -1288,7 +1352,8 @@ void conv_3D_gpu(
       /* const int groups = */ groups,
       /* const bool flip = */ flip,
   };
-  return dispatch_conv_3D_gpu(s, d, in, wt, out, conv_params, copies);
+  return dispatch_conv_3D_gpu(
+      s, d, in, wt, out, conv_params, copies, output_bias);
 }
 
 } // namespace
@@ -1304,6 +1369,10 @@ void Convolution::eval_gpu(const std::vector<array>& inputs, array& out) {
   // Some shortcuts for brevity
   const array& in = inputs[0];
   const array& wt = inputs[1];
+  std::optional<array> output_bias = std::nullopt;
+  if (output_bias_) {
+    output_bias = ensure_row_contiguous(inputs[2], d, s);
+  }
 
   // 3D conv
   if (out.ndim() == 5) {
@@ -1319,7 +1388,8 @@ void Convolution::eval_gpu(const std::vector<array>& inputs, array& out) {
         input_dilation_,
         groups_,
         flip_,
-        copies);
+        copies,
+        output_bias);
   }
   // 2D conv
   else if (out.ndim() == 4) {
@@ -1335,7 +1405,8 @@ void Convolution::eval_gpu(const std::vector<array>& inputs, array& out) {
         input_dilation_,
         groups_,
         flip_,
-        copies);
+        copies,
+        output_bias);
   }
   // 1D conv
   else if (out.ndim() == 3) {
diff --git a/mlx/backend/metal/jit_kernels.cpp b/mlx/backend/metal/jit_kernels.cpp
