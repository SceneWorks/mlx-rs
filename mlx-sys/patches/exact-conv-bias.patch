diff --git a/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.h b/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.h
index f559596..b07533d 100644
--- a/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.h
+++ b/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.h
@@ -12,7 +12,8 @@ template <
     int WM,
     int WN,
     int N_CHANNELS = 0,
-    bool SMALL_FILTER = false>
+    bool SMALL_FILTER = false,
+    bool HAS_OUTPUT_BIAS = false>
 [[kernel, max_total_threads_per_threadgroup(WM * WN * 32)]] void
 implicit_gemm_conv_2d(
     const device T* A [[buffer(0)]],
@@ -20,6 +21,7 @@ implicit_gemm_conv_2d(
     device T* C [[buffer(2)]],
     const constant MLXConvParams<2>* params [[buffer(3)]],
     const constant ImplicitGemmConv2DParams* gemm_params [[buffer(4)]],
+    const device T* output_bias [[buffer(5)]],
     uint3 tid [[threadgroup_position_in_grid]],
     uint3 lid [[thread_position_in_threadgroup]],
     uint simd_gid [[simdgroup_index_in_threadgroup]],
@@ -172,5 +174,14 @@ implicit_gemm_conv_2d(
   short tgp_bm = min(BM, gemm_params->M - c_row);
   short tgp_bn = min(BN, gemm_params->N - c_col);
   const int ldc = N * params->groups;
+  if constexpr (HAS_OUTPUT_BIAS) {
+    const TransformAdd<T, float> epilogue(1.0f, 1.0f);
+    mma_op.apply_epilogue_safe(
+        output_bias + tid.z * N + c_col,
+        0,
+        1,
+        short2(tgp_bn, tgp_bm),
+        epilogue);
+  }
   mma_op.store_result_safe(C, ldc, short2(tgp_bn, tgp_bm));
 }
diff --git a/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.metal b/mlx/backend/metal/kernels/steel/conv/kernels/steel_conv.metal
index 7851e5e..19b9405 100644
