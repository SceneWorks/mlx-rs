diff --git a/mlx/backend/metal/eval.cpp b/mlx/backend/metal/eval.cpp
index e682625..d923511 100644
--- a/mlx/backend/metal/eval.cpp
+++ b/mlx/backend/metal/eval.cpp
@@ -8,6 +8,75 @@
 #include "mlx/scheduler.h"
 #include "mlx/utils.h"
 
+// pmetal (sc-5009 / sc-12780 / sc-12786): debug-only test hook for the
+// recoverable command-buffer path.
+//
+// MLX 0.32.0 makes an asynchronous Metal command-buffer error recoverable
+// UPSTREAM: the completion handler in CommandEncoder::commit() (device.cpp)
+// RECORDS the error into the per-encoder error_ and POISONS the buffer's
+// signal events via EventImpl::set_error() instead of throwing — throwing
+// there runs on an internal Metal thread, crosses a noexcept boundary, and
+// std::terminate()s (SIGABRT). The poisoned error is re-thrown synchronously
+// on the waiting (host) thread by EventImpl::wait() -> check_error(), or by
+// CommandEncoder::synchronize(). This is the behavior the old 0.31.2 pmetal
+// patch added by hand, so NO production record-not-throw patch is required at
+// 0.32.0.
+//
+// What upstream does NOT provide is a way to drive that path DETERMINISTICALLY
+// from a test without tripping the real GPU watchdog (non-deterministic, and it
+// can disrupt the host display). This hook records a synthetic error that
+// Event::signal() (event.cpp) drains on the host thread at signal-encode time
+// and injects through the REAL upstream poison mechanism — the same
+// EventImpl::set_error() call the commit() completion handler's poison loop
+// makes. From there the error surfaces through UNPATCHED upstream code only
+// (EventImpl::wait -> check_error -> throw on the waiting thread), so the test
+// regression-guards the actual 0.32.0 poison/re-raise plumbing (sc-12786).
+//
+// The injection is deliberately NOT placed in the completion handler itself:
+// for a successfully-completed buffer the GPU signals the shared event BEFORE
+// the handler runs on Metal's callback thread, so a handler-side injection
+// races the waiter's check_error() and the test would flake. (A real
+// command-buffer ERROR has no such race: Metal does not signal the events, and
+// the handler poisons them before manually signaling.) Draining at
+// Event::signal() — on the host thread, strictly before the host-side wait can
+// begin — keeps the test deterministic while still exercising the real
+// set_error/check_error path.
+//
+// Compiled out of release builds via NDEBUG, so it adds no production symbol.
+// Tests declare it with `extern "C"`
+// (mlx-tests/tests/command_buffer_recoverable.rs).
+#ifndef NDEBUG
+namespace mlx::core::metal {
+namespace {
+std::mutex g_injected_cb_error_mtx;
+bool g_injected_cb_error_set = false;
+std::string g_injected_cb_error_msg;
+} // namespace
+
+// Drain a synthetically-injected command-buffer error (debug/test only).
+// Returns true and fills `out` if one was pending, and clears it so exactly
+// one event is poisoned per injection — mirroring how a real command-buffer
+// error is taken exactly once by the waiter (check_error's atomic exchange).
+bool take_injected_command_buffer_error(std::string& out) {
+  std::lock_guard<std::mutex> lk(g_injected_cb_error_mtx);
+  if (!g_injected_cb_error_set) {
+    return false;
+  }
+  out = g_injected_cb_error_msg;
+  g_injected_cb_error_msg.clear();
+  g_injected_cb_error_set = false;
+  return true;
+}
+} // namespace mlx::core::metal
+
+extern "C" void mlx_pmetal_test_inject_command_buffer_error(const char* msg) {
+  std::lock_guard<std::mutex> lk(mlx::core::metal::g_injected_cb_error_mtx);
+  mlx::core::metal::g_injected_cb_error_set = true;
+  mlx::core::metal::g_injected_cb_error_msg =
+      msg != nullptr ? std::string(msg) : std::string("synthetic");
+}
+#endif
+
 namespace mlx::core::gpu {
 
 void init() {}
