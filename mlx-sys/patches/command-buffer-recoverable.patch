diff --git a/mlx/backend/metal/eval.cpp b/mlx/backend/metal/eval.cpp
index e682625..a047dcc 100644
--- a/mlx/backend/metal/eval.cpp
+++ b/mlx/backend/metal/eval.cpp
@@ -8,6 +8,58 @@
 #include "mlx/scheduler.h"
 #include "mlx/utils.h"
 
+// pmetal (sc-5009 / sc-12780): debug-only test hook for the recoverable
+// command-buffer path.
+//
+// MLX 0.32.0 already makes an asynchronous Metal command-buffer error
+// recoverable UPSTREAM: the completion handler in CommandEncoder::commit()
+// (device.cpp) RECORDS the error into the per-encoder error_ and poisons the
+// signal events instead of throwing — throwing there runs on an internal Metal
+// thread, crosses a noexcept boundary, and std::terminate()s (SIGABRT). The
+// recorded error is re-thrown synchronously on the waiting thread
+// (CommandEncoder::synchronize / EventImpl::check_error). This is exactly the
+// behavior the old 0.31.2 pmetal patch added by hand, so NO production
+// record-not-throw patch is required at 0.32.0.
+//
+// What upstream does NOT provide is a way to drive that path DETERMINISTICALLY
+// from a test without tripping the real GPU watchdog (non-deterministic, and it
+// can disrupt the host display). This hook records a synthetic error into a
+// debug-only slot that the host-blocking Event::wait() (event.cpp) drains and
+// re-throws — the same host-wait path a real poisoned event surfaces through.
+// It is compiled out of release builds via NDEBUG, so it adds no production
+// symbol. Tests declare it with `extern "C"`
+// (mlx-tests/tests/command_buffer_recoverable.rs).
+#ifndef NDEBUG
+namespace mlx::core::metal {
+namespace {
+std::mutex g_injected_cb_error_mtx;
+bool g_injected_cb_error_set = false;
+std::string g_injected_cb_error_msg;
+} // namespace
+
+// Drain a synthetically-injected command-buffer error (debug/test only). Returns
+// true and fills `out` if one was pending, and clears it so it is not sticky —
+// mirroring how a real command-buffer error is taken exactly once by the waiter.
+bool take_injected_command_buffer_error(std::string& out) {
+  std::lock_guard<std::mutex> lk(g_injected_cb_error_mtx);
+  if (!g_injected_cb_error_set) {
+    return false;
+  }
+  out = g_injected_cb_error_msg;
+  g_injected_cb_error_msg.clear();
+  g_injected_cb_error_set = false;
+  return true;
+}
+} // namespace mlx::core::metal
+
+extern "C" void mlx_pmetal_test_inject_command_buffer_error(const char* msg) {
+  std::lock_guard<std::mutex> lk(mlx::core::metal::g_injected_cb_error_mtx);
+  mlx::core::metal::g_injected_cb_error_set = true;
+  mlx::core::metal::g_injected_cb_error_msg =
+      msg != nullptr ? std::string(msg) : std::string("synthetic");
+}
+#endif
+
 namespace mlx::core::gpu {
 
 void init() {}
diff --git a/mlx/backend/metal/event.cpp b/mlx/backend/metal/event.cpp
index 77f48f0..c5b774c 100644
--- a/mlx/backend/metal/event.cpp
+++ b/mlx/backend/metal/event.cpp
@@ -3,6 +3,16 @@
 #include "mlx/backend/metal/event.h"
 #include "mlx/scheduler.h"
 
+// pmetal (sc-5009 / sc-12780): defined in eval.cpp, debug/test builds only.
+// Drains a synthetically-injected command-buffer error so the recoverable-error
+// path can be exercised deterministically without tripping the real GPU
+// watchdog. See the block comment in eval.cpp.
+#ifndef NDEBUG
+namespace mlx::core::metal {
+bool take_injected_command_buffer_error(std::string& out);
+} // namespace mlx::core::metal
+#endif
+
 namespace mlx::core {
 
 ///////////////////////////////////////////////////////////////////////////////
@@ -57,6 +67,18 @@ Event::Event(Stream stream) : stream_(stream) {
 }
 
 void Event::wait() {
+#ifndef NDEBUG
+  // pmetal (sc-5009 / sc-12780): surface a synthetically-injected command-buffer
+  // error here, on the calling (host) thread, as a catchable std::runtime_error
+  // — the same host-wait path a real poisoned event surfaces through
+  // (EventImpl::check_error). Debug/test only; compiled out of release builds.
+  {
+    std::string injected;
+    if (metal::take_injected_command_buffer_error(injected)) {
+      throw std::runtime_error(injected);
+    }
+  }
+#endif
   static_cast<metal::EventImpl*>(event_.get())->wait(value());
 }
 
