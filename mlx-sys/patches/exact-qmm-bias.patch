+  instantiate_quantized_aligned_batched(affine_qmm_bias_t, type, group_size, bits, true, 1) \
+  instantiate_quantized_aligned_batched(affine_qmm_bias_t, type, group_size, bits, true, 0) \
+  instantiate_quantized_aligned_batched(affine_qmm_bias_t, type, group_size, bits, false, 1) \
+  instantiate_quantized_aligned_batched(affine_qmm_bias_t, type, group_size, bits, false, 0)
+
+#define instantiate_qmm_bias_group(group_size, bits) \
+  instantiate_qmm_bias_type(float, group_size, bits) \
+  instantiate_qmm_bias_type(float16_t, group_size, bits) \
+  instantiate_qmm_bias_type(bfloat16_t, group_size, bits)
+
+#define instantiate_qmm_bias_bits(bits) \
+  instantiate_qmm_bias_group(32, bits) \
+  instantiate_qmm_bias_group(64, bits) \
+  instantiate_qmm_bias_group(128, bits)
+
+instantiate_quantized_all()
+instantiate_qmm_bias_bits(4)
+instantiate_qmm_bias_bits(8) // clang-format on
