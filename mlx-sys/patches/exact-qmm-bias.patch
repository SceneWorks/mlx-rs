diff --git a/mlx/backend/metal/kernels/quantized.h b/mlx/backend/metal/kernels/quantized.h
index 345dfc7..79fa8e1 100644
--- a/mlx/backend/metal/kernels/quantized.h
+++ b/mlx/backend/metal/kernels/quantized.h
@@ -1189,13 +1189,15 @@ template <
     const bool aligned_N,
     const int BM = 32,
     const int BK = 32,
-    const int BN = 32>
+    const int BN = 32,
+    const bool has_output_bias = false>
 METAL_FUNC void qmm_t_impl(
     const device uint32_t* w,
     const device T* scales,
     const device T* biases,
     const device T* x,
     device T* y,
+    const device T* output_bias,
     threadgroup T* Xs,
     threadgroup T* Ws,
     const constant int& K,
@@ -1301,8 +1303,22 @@ METAL_FUNC void qmm_t_impl(
     }
   }
 
-  // Store results to device memory
+  // Preserve the eager `quantized_matmul` then `add` rounding contract: first
+  // round the accumulator to T, then add the dense bias in T before storing.
   threadgroup_barrier(mem_flags::mem_threadgroup);
+  if constexpr (has_output_bias) {
+    const mlx::steel::TransformAdd<T, float> epilogue(1.0f, 1.0f);
+    if (num_els < BM || num_outs < BN) {
+      mma_op.apply_epilogue_safe(
+          output_bias + y_col,
+          0,
+          1,
+          short2(num_outs, num_els),
+          epilogue);
+    } else {
+      mma_op.apply_epilogue(output_bias + y_col, 0, 1, epilogue);
+    }
+  }
   if (num_els < BM || num_outs < BN) {
     mma_op.store_result_safe(y, N, short2(num_outs, num_els));
   } else {
@@ -1928,6 +1944,81 @@ template <
       biases,
       x,
       y,
+      y,
+      Xs,
+      Ws,
+      K,
+      N,
+      M,
+      K,
+      tid,
+      lid,
+      simd_gid,
+      simd_lid);
+}
+
+template <
+    typename T,
+    const int group_size,
+    const int bits,
+    const bool aligned_N,
+    const bool batched,
+    const int BM = 32,
+    const int BK = 32,
+    const int BN = 32>
+[[kernel]] void affine_qmm_bias_t(
+    const device uint32_t* w [[buffer(0)]],
+    const device T* scales [[buffer(1)]],
+    const device T* biases [[buffer(2)]],
+    const device T* x [[buffer(3)]],
+    const device T* output_bias [[buffer(4)]],
+    device T* y [[buffer(5)]],
+    const constant int& K [[buffer(6)]],
+    const constant int& N [[buffer(7)]],
+    const constant int& M [[buffer(8)]],
+    const constant int& x_batch_ndims [[buffer(9)]],
+    const constant int* x_shape [[buffer(10)]],
+    const constant int64_t* x_strides [[buffer(11)]],
+    const constant int& w_batch_ndims [[buffer(12)]],
+    const constant int* w_shape [[buffer(13)]],
+    const constant int64_t* w_strides [[buffer(14)]],
+    const constant int64_t* s_strides [[buffer(15)]],
+    const constant int64_t* b_strides [[buffer(16)]],
+    uint3 tid [[threadgroup_position_in_grid]],
+    uint lid [[thread_index_in_threadgroup]],
+    uint simd_gid [[simdgroup_index_in_threadgroup]],
+    uint simd_lid [[thread_index_in_simdgroup]]) {
+  (void)lid;
+
+  constexpr int BK_padded = (BK + 16 / sizeof(T));
+  threadgroup T Xs[BM * BK_padded];
+  threadgroup T Ws[BN * BK_padded];
+
+  if (batched) {
+    adjust_matrix_offsets<T>(
+        x,
+        w,
+        scales,
+        biases,
+        y,
+        M * N,
+        x_batch_ndims,
+        x_shape,
+        x_strides,
+        w_batch_ndims,
+        w_shape,
+        w_strides,
+        s_strides,
+        b_strides,
+        tid);
+  }
+  qmm_t_impl<T, group_size, bits, aligned_N, BM, BK, BN, true>(
+      w,
+      scales,
+      biases,
+      x,
+      y,
+      output_bias,
       Xs,
       Ws,
       K,
@@ -1987,6 +2078,7 @@ template <
       biases,
       x,
       y,
+      y,
       Xs,
       Ws,
       K,
@@ -2316,6 +2408,7 @@ template <
       biases,
       x,
       y,
+      y,
       Xs,
       Ws,
       K,
