+TEST_CASE("test exact quantized matmul output-bias epilogue") {
+  if (!is_available(Device::gpu)) {
+    return;
+  }
+
+  constexpr int M = 512;
+  constexpr int N = 1024;
+  constexpr int K = 128;
+  auto input_f32 = reshape(sin(arange(0, M * K, float32) * 0.003f), {M, K});
+  auto weight_f32 =
+      reshape(cos(arange(0, N * K, float32) * 0.002f), {N, K});
+  auto output_bias_f32 = sin(arange(0, N, float32) * 0.01f);
+
+  for (auto dtype : {float32, float16, bfloat16}) {
+    auto input = astype(input_f32, dtype);
+    auto weight = astype(weight_f32, dtype);
+    auto output_bias = astype(output_bias_f32, dtype);
+    for (int bits : {4, 8}) {
+      for (int group_size : {32, 64, 128}) {
+        auto quantized = quantize(weight, group_size, bits);
+        auto eager = add(
+            quantized_matmul(
+                input,
+                quantized[0],
+                quantized[1],
+                quantized[2],
+                true,
+                group_size,
+                bits),
+            output_bias);
+        auto fused = quantized_matmul_bias(
+            input,
+            quantized[0],
+            quantized[1],
+            quantized[2],
+            output_bias,
+            true,
+            group_size,
+            bits);
+        CHECK(array_equal(eager, fused).item<bool>());
+      }
+    }
+  }
+
+  auto quantized = quantize(weight_f32, 64, 4);
+  CHECK_THROWS_AS(
+      quantized_matmul_bias(
+          zeros({16, K}),
+          quantized[0],
+          quantized[1],
+          quantized[2],
+          output_bias_f32,
+          true,
+          64,
+          4),
+      std::invalid_argument);
+}
