diff --git a/mlx/ops.cpp b/mlx/ops.cpp
index 849b808..52a4cb5 100644
--- a/mlx/ops.cpp
+++ b/mlx/ops.cpp
@@ -4677,6 +4677,98 @@ array quantized_matmul(
       std::move(inputs));
 }
 
+array quantized_matmul_bias(
+    array x,
+    array w,
+    array scales,
+    array biases,
+    array output_bias,
+    bool transpose /* = true */,
+    std::optional<int> group_size_ /* = std::nullopt */,
+    std::optional<int> bits_ /* = std::nullopt */,
+    StreamOrDevice s /* = {} */) {
+  constexpr std::string_view tag = "quantized_matmul_bias";
+  auto stream = to_stream(s);
+  if (stream.device != Device::gpu || !metal::is_available()) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] The exact fused epilogue is Metal-only.");
+  }
+  if (!transpose) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] Only transpose=true is supported.");
+  }
+  if (w.ndim() != 2) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] The quantized weight must be 2D.");
+  }
+
+  auto [dtype, qmode] = validate_mode_with_type(
+      tag, scales, std::optional<array>(biases), std::nullopt, "affine");
+  auto [group_size, bits] =
+      quantization_params_from_mode(qmode, group_size_, bits_);
+  if ((bits != 4 && bits != 8) ||
+      (group_size != 32 && group_size != 64 && group_size != 128)) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] Only Q4/Q8 with group size 32, 64, or 128 "
+        "is supported.");
+  }
+
+  auto [w_inner_dims, w_outer_dims] = extract_quantized_matmul_dims(
+      tag,
+      x,
+      w,
+      scales,
+      std::optional<array>(biases),
+      true,
+      group_size,
+      bits);
+  dtype = promote_types(x.dtype(), dtype);
+  if (!issubdtype(dtype, floating)) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] Only real floating types are supported.");
+  }
+  if (output_bias.ndim() != 1 || output_bias.shape(0) != w_outer_dims) {
+    std::ostringstream msg;
+    msg << "[quantized_matmul_bias] Output bias must have shape ("
+        << w_outer_dims << ") but got " << output_bias.shape() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (output_bias.dtype() != dtype) {
+    std::ostringstream msg;
+    msg << "[quantized_matmul_bias] Output bias dtype must equal the qmm "
+        << "output dtype " << dtype << " but got " << output_bias.dtype()
+        << ".";
+    throw std::invalid_argument(msg.str());
+  }
+
+  // The eager baseline selects qmm only above the device-dependent vector
+  // threshold (never greater than 32), and its split-K path delegates to qmm
+  // exactly when there are at least 512 32x32 output tiles.  Requiring both
+  // conditions keeps the fused and eager qmm algorithms identical.
+  int M = x.size() / w_inner_dims;
+  int tile_count = ((M + 31) / 32) * ((w_outer_dims + 31) / 32);
+  if (M < 32 || tile_count < 512) {
+    throw std::invalid_argument(
+        "[quantized_matmul_bias] Shape does not select the direct qmm path; "
+        "use the eager fallback.");
+  }
+
+  std::vector<array> inputs{
+      astype(x, dtype),
+      std::move(w),
+      astype(scales, dtype),
+      astype(biases, dtype),
+      std::move(output_bias)};
+  auto out_shape = inputs[0].shape();
