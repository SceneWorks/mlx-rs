+          const T rounded = static_cast<T>(Dtile.elems()[i]);
+          Dtile.elems()[i] = static_cast<float>(
+              static_cast<T>(rounded + bias_tile.elems()[i]));
+        }
+      }
+
       if constexpr (kAlignedM.value && kAlignedN.value) {
         Dtile.store(y + tm * N + tn, N);
       } else if (kAlignedM.value && sgp_sn == SN) {
@@ -1248,7 +1262,90 @@ template <
