From c9857b91c86aebc76e723e3a7f42f00d1e2c195e Mon Sep 17 00:00:00 2001
From: Michael Trefry <michael@trefry.net>
Date: Thu, 13 Aug 2026 01:02:52 -0400
Subject: [PATCH] test(exact): cover odd batched dispatcher shapes

Signed-off-by: Michael Trefry <michael@trefry.net>
---
 tests/ops_tests.cpp | 68 +++++++++++++++++++++++++++++++++------------
 1 file changed, 51 insertions(+), 17 deletions(-)

diff --git a/tests/ops_tests.cpp b/tests/ops_tests.cpp
index a67b086..f05a086 100644
--- a/tests/ops_tests.cpp
+++ b/tests/ops_tests.cpp
@@ -3317,18 +3317,10 @@ TEST_CASE("test exact quantized matmul output-bias epilogue") {
     return;
   }
 
-  constexpr int M = 512;
-  constexpr int N = 1024;
   constexpr int K = 128;
-  auto input_f32 = reshape(sin(arange(0, M * K, float32) * 0.003f), {M, K});
-  auto weight_f32 =
-      reshape(cos(arange(0, N * K, float32) * 0.002f), {N, K});
-  auto output_bias_f32 = sin(arange(0, N, float32) * 0.01f);
-
-  for (auto dtype : {float32, float16, bfloat16}) {
-    auto input = astype(input_f32, dtype);
-    auto weight = astype(weight_f32, dtype);
-    auto output_bias = astype(output_bias_f32, dtype);
+  auto check = [](const array& input,
+                  const array& weight,
+                  const array& output_bias) {
     for (int bits : {4, 8}) {
       for (int group_size : {32, 64, 128}) {
         auto quantized = quantize(weight, group_size, bits);
@@ -3354,6 +3346,36 @@ TEST_CASE("test exact quantized matmul output-bias epilogue") {
         CHECK(array_equal(eager, fused).item<bool>());
       }
     }
+  };
+
+  constexpr int M = 512;
+  constexpr int N = 1024;
+  auto input_f32 = reshape(sin(arange(0, M * K, float32) * 0.003f), {M, K});
+  auto weight_f32 =
+      reshape(cos(arange(0, N * K, float32) * 0.002f), {N, K});
+  auto output_bias_f32 = sin(arange(0, N, float32) * 0.01f);
+
+  // The odd case is simultaneously batched and non-contiguous. Its 1-D bias
+  // broadcasts over both leading axes, and its tile count still selects direct
+  // qmm rather than split-K, exercising the exact standard/NAX epilogues.
+  constexpr int ODD_M = 257;
+  constexpr int ODD_N = 1001;
+  auto odd_input_base_f32 = reshape(
+      sin(arange(0, 2 * K * ODD_M, float32) * 0.003f),
+      {2, K, ODD_M});
+  auto odd_weight_f32 = reshape(
+      cos(arange(0, ODD_N * K, float32) * 0.002f), {ODD_N, K});
+  auto odd_output_bias_f32 = sin(arange(0, ODD_N, float32) * 0.01f);
+
+  for (auto dtype : {float32, float16, bfloat16}) {
+    check(
+        astype(input_f32, dtype),
+        astype(weight_f32, dtype),
+        astype(output_bias_f32, dtype));
+    check(
+        transpose(astype(odd_input_base_f32, dtype), {0, 2, 1}),
+        astype(odd_weight_f32, dtype),
+        astype(odd_output_bias_f32, dtype));
   }
 
   auto quantized = quantize(weight_f32, 64, 4);
@@ -3379,15 +3401,24 @@ TEST_CASE("test exact convolution output-bias epilogues") {
     auto check = [dtype](
                      const Shape& input_shape,
                      const Shape& weight_shape,
-                     const std::vector<int>& padding) {
+                     const std::vector<int>& padding,
+                     bool noncontiguous = false) {
       auto numel = [](const Shape& shape) {
         return std::accumulate(shape.begin(), shape.end(), 1, std::multiplies<>());
       };
+      Shape source_shape = input_shape;
+      if (noncontiguous) {
+        REQUIRE(input_shape.size() == 4);
+        std::swap(source_shape[1], source_shape[2]);
+      }
       auto input = astype(
           reshape(
-              sin(arange(0, numel(input_shape), float32) * 0.01f),
-              input_shape),
+              sin(arange(0, numel(source_shape), float32) * 0.01f),
+              source_shape),
           dtype);
+      if (noncontiguous) {
+        input = transpose(input, {0, 2, 1, 3});
+      }
       auto weight = astype(
           reshape(
               cos(arange(0, numel(weight_shape), float32) * 0.02f),
@@ -3418,10 +3449,13 @@ TEST_CASE("test exact convolution output-bias epilogues") {
       CHECK(array_equal(eager, fused).item<bool>());
     };
 
-    // Regular and general 2D implicit-GEMM dispatches, then 3D implicit GEMM.
+    // Regular and general 2D implicit-GEMM dispatches, including odd, batched,
+    // bias-broadcast, and non-contiguous inputs, then 3D implicit GEMM.
     check({1, 8, 8, 16}, {16, 3, 3, 16}, {1, 1});
-    check({1, 16, 16, 5}, {7, 3, 3, 5}, {1, 1});
-    check({1, 4, 4, 4, 16}, {16, 3, 3, 3, 16}, {1, 1, 1});
+    check({2, 9, 11, 16}, {16, 3, 3, 16}, {1, 1});
+    check({2, 9, 11, 16}, {16, 3, 3, 16}, {1, 1}, true);
+    check({2, 15, 17, 5}, {7, 3, 3, 5}, {1, 1});
+    check({2, 3, 5, 7, 16}, {16, 3, 3, 3, 16}, {1, 1, 1});
   }
 
   auto winograd_input = zeros({1, 64, 64, 128});
-- 
