--- a/mlx/c/ops.h
+++ b/mlx/c/ops.h
@@ -817,6 +817,17 @@ int mlx_quantized_matmul(
     mlx_optional_int bits,
     const char* mode,
     const mlx_stream s);
+int mlx_pmetal_quantized_matmul_bias(
+    mlx_array* res,
+    const mlx_array x,
+    const mlx_array w,
+    const mlx_array scales,
+    const mlx_array biases,
+    const mlx_array output_bias,
+    bool transpose,
+    mlx_optional_int group_size,
+    mlx_optional_int bits,
+    const mlx_stream s);
 int mlx_radians(mlx_array* res, const mlx_array a, const mlx_stream s);
 int mlx_real(mlx_array* res, const mlx_array a, const mlx_stream s);
 int mlx_reciprocal(mlx_array* res, const mlx_array a, const mlx_stream s);
