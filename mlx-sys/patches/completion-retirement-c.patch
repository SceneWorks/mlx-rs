+// CPU/Metal completed-range receipts. Creation joins owners; only wait observes
+// and acknowledges the captured range. Free/drop without wait never acks.
+extern "C" int mlx_pmetal_retirement_fence_new(void** out, mlx_stream stream) {
+  try {
+    auto fence = std::make_unique<mlx::core::RetirementFence>();
+    *fence = mlx::core::retirement_fence(mlx_stream_get_(stream));
+    *out = fence.release();
+  } catch (const std::exception& e) {
+    mlx_error(e.what()); return 1;
+  } catch (...) {
+    mlx_error("[retirement_fence] Unknown capture error."); return 1;
+  }
+  return 0;
+}
+extern "C" int mlx_pmetal_retirement_fence_wait(void* fence) {
+  try {
+    static_cast<mlx::core::RetirementFence*>(fence)->wait();
+  } catch (const std::exception& e) {
+    mlx_error(e.what()); return 1;
+  } catch (...) {
+    mlx_error("[retirement_fence] Unknown completion error."); return 1;
+  }
+  return 0;
+}
+extern "C" void mlx_pmetal_retirement_fence_free(void* fence) {
+  delete static_cast<mlx::core::RetirementFence*>(fence);
+}
+extern "C" int mlx_pmetal_synchronize_and_retire(mlx_stream stream) {
+  try {
+    mlx::core::synchronize_and_retire(mlx_stream_get_(stream));
+  } catch (const std::exception& e) {
+    mlx_error(e.what()); return 1;
+  } catch (...) {
+    mlx_error("[synchronize_and_retire] Unknown completion error."); return 1;
+  }
+  return 0;
+}
