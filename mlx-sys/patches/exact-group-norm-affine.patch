+// Copyright © 2026 Apple Inc.
+
+#include <metal_common>
+#include <metal_simdgroup>
+
+#include "mlx/backend/metal/kernels/utils.h"
+
+using namespace metal;
+
+template <int N = 1>
+inline void group_norm_initialize_buffer(
+    threadgroup float* xs,
+    uint simd_lane_id [[thread_index_in_simdgroup]],
+    uint simd_group_id [[simdgroup_index_in_threadgroup]]) {
+  if (simd_group_id == 0) {
+    for (int i = 0; i < N; i++) {
+      xs[N * simd_lane_id + i] = 0;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+}
+
+template <int N = 1>
+inline void group_norm_threadgroup_sum(
+    thread float* x,
+    threadgroup float* xs,
+    uint simd_lane_id [[thread_index_in_simdgroup]],
+    uint simd_group_id [[simdgroup_index_in_threadgroup]]) {
+  for (int i = 0; i < N; i++) {
+    x[i] = simd_sum(x[i]);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (simd_lane_id == 0) {
+    for (int i = 0; i < N; i++) {
+      xs[N * simd_group_id + i] = x[i];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (int i = 0; i < N; i++) {
+    x[i] = xs[N * simd_lane_id + i];
+    x[i] = simd_sum(x[i]);
+  }
+}
+
+inline size_t group_norm_offset(
+    uint gid,
+    uint group_offset,
+    uint axis_size,
+    uint group_size,
+    uint num_groups) {
+  const uint batch = gid / num_groups;
+  const uint group = gid % num_groups;
+  const uint spatial = group_offset / group_size;
+  const uint channel_in_group = group_offset % group_size;
+  const uint channels = group_size * num_groups;
+  return static_cast<size_t>(batch) * axis_size * num_groups +
+      static_cast<size_t>(spatial) * channels + group * group_size +
+      channel_in_group;
+}
+
+// The reduction and launch geometry intentionally mirror layer_norm_single_row
+// exactly. The only difference is the channel-aware affine index. The explicit
+// T temporaries preserve eager GroupNorm's three boundaries: LayerNorm writes
+// T, multiply writes T, and add writes T.
+template <typename T, int N_READS = 8>
+[[kernel]] void group_norm_affine_single_row(
+    const device T* x,
+    const device T* weight,
+    const device T* bias,
+    device T* out,
+    constant float& eps,
+    constant uint& axis_size,
+    constant uint& group_size,
+    constant uint& num_groups,
+    uint gid [[threadgroup_position_in_grid]],
+    uint lid [[thread_position_in_threadgroup]],
+    uint simd_lane_id [[thread_index_in_simdgroup]],
+    uint simd_group_id [[simdgroup_index_in_threadgroup]]) {
+  constexpr int SIMD_SIZE = 32;
+
+  float thread_x[N_READS] = {0};
+  threadgroup float local_buffer[SIMD_SIZE] = {0};
+  group_norm_initialize_buffer(local_buffer, simd_lane_id, simd_group_id);
+
+  const uint lane_base = lid * N_READS;
+  const bool safe = lane_base + N_READS <= axis_size;
+  const int n = axis_size - lane_base;
+
+  if (safe) {
+    for (int i = 0; i < N_READS; i++) {
+      thread_x[i] = x[group_norm_offset(
+          gid, lane_base + i, axis_size, group_size, num_groups)];
+    }
+  } else {
+    for (int i = 0; i < n; i++) {
+      thread_x[i] = x[group_norm_offset(
+          gid, lane_base + i, axis_size, group_size, num_groups)];
+    }
+  }
+
+  float mean = 0;
+  for (int i = 0; i < N_READS; i++) {
+    mean += thread_x[i];
+  }
+  group_norm_threadgroup_sum(&mean, local_buffer, simd_lane_id, simd_group_id);
+  mean /= axis_size;
+
+  float normalizer = 0;
+  if (!safe) {
+    for (int i = n; i < N_READS; i++) {
+      thread_x[i] = mean;
+    }
+  }
+  for (int i = 0; i < N_READS; i++) {
+    thread_x[i] -= mean;
+    normalizer += thread_x[i] * thread_x[i];
+  }
+  group_norm_threadgroup_sum(
+      &normalizer, local_buffer, simd_lane_id, simd_group_id);
+  normalizer = metal::precise::rsqrt(normalizer / axis_size + eps);
+
+  const uint group = gid % num_groups;
+  const int count = safe ? N_READS : n;
+  for (int i = 0; i < count; i++) {
+    thread_x[i] *= normalizer;
+    const uint group_offset = lane_base + i;
+    const uint channel = group * group_size + group_offset % group_size;
+    const size_t offset =
+        group_norm_offset(gid, group_offset, axis_size, group_size, num_groups);
+    const T normed = static_cast<T>(thread_x[i]);
+    const T scaled = static_cast<T>(normed * weight[channel]);
+    out[offset] = static_cast<T>(scaled + bias[channel]);
+  }
+}
+
+template <typename T, int N_READS = 4>
+[[kernel]] void group_norm_affine_looped(
+    const device T* x,
+    const device T* weight,
+    const device T* bias,
+    device T* out,
+    constant float& eps,
+    constant uint& axis_size,
+    constant uint& group_size,
+    constant uint& num_groups,
+    uint gid [[threadgroup_position_in_grid]],
+    uint lid [[thread_position_in_threadgroup]],
+    uint lsize [[threads_per_threadgroup]],
+    uint simd_lane_id [[thread_index_in_simdgroup]],
+    uint simd_group_id [[simdgroup_index_in_threadgroup]]) {
+  constexpr int SIMD_SIZE = 32;
+
+  threadgroup float local_buffer[SIMD_SIZE];
+  group_norm_initialize_buffer(local_buffer, simd_lane_id, simd_group_id);
+
+  float mean = 0;
+  for (uint r = 0; r < axis_size; r += lsize * N_READS) {
+    if (r + lid * N_READS + N_READS <= axis_size) {
+      for (int i = 0; i < N_READS; i++) {
+        const uint group_offset = r + lid * N_READS + i;
+        mean += x[group_norm_offset(
+            gid, group_offset, axis_size, group_size, num_groups)];
+      }
+    } else {
+      for (int i = 0; i < N_READS; i++) {
+        if ((r + lid * N_READS + i) < axis_size) {
+          const uint group_offset = r + lid * N_READS + i;
+          mean += x[group_norm_offset(
+              gid, group_offset, axis_size, group_size, num_groups)];
+        }
+      }
+    }
+  }
+  group_norm_threadgroup_sum(&mean, local_buffer, simd_lane_id, simd_group_id);
+  mean /= axis_size;
+
+  float normalizer = 0;
+  for (uint r = 0; r < axis_size; r += lsize * N_READS) {
+    if (r + lid * N_READS + N_READS <= axis_size) {
+      for (int i = 0; i < N_READS; i++) {
+        const uint group_offset = r + lid * N_READS + i;
+        float t = x[group_norm_offset(
+                      gid, group_offset, axis_size, group_size, num_groups)] -
+            mean;
+        normalizer += t * t;
+      }
+    } else {
+      for (int i = 0; i < N_READS; i++) {
+        if ((r + lid * N_READS + i) < axis_size) {
+          const uint group_offset = r + lid * N_READS + i;
+          float t = x[group_norm_offset(
+                        gid, group_offset, axis_size, group_size, num_groups)] -
+              mean;
+          normalizer += t * t;
+        }
+      }
+    }
+  }
+  group_norm_threadgroup_sum(
+      &normalizer, local_buffer, simd_lane_id, simd_group_id);
+  normalizer = metal::precise::rsqrt(normalizer / axis_size + eps);
+
+  const uint group = gid % num_groups;
+  for (uint r = 0; r < axis_size; r += lsize * N_READS) {
+    for (int i = 0; i < N_READS; i++) {
+      const uint group_offset = r + lid * N_READS + i;
+      if (group_offset < axis_size) {
+        const size_t offset = group_norm_offset(
+            gid, group_offset, axis_size, group_size, num_groups);
+        float xi = (x[offset] - mean) * normalizer;
+        const uint channel = group * group_size + group_offset % group_size;
+        const T normed = static_cast<T>(xi);
+        const T scaled = static_cast<T>(normed * weight[channel]);
+        out[offset] = static_cast<T>(scaled + bias[channel]);
+      }
+    }
+  }
+}
+
+// clang-format off
+#define instantiate_group_norm(name, itype)                                     \
+  instantiate_kernel(                                                          \
+      "group_norm_affine" #name, group_norm_affine_single_row, itype)          \
+  instantiate_kernel(                                                          \
+      "group_norm_affine_looped" #name, group_norm_affine_looped, itype)
+
+instantiate_group_norm(float32, float)
+instantiate_group_norm(float16, half)
+instantiate_group_norm(bfloat16, bfloat16_t) // clang-format on
