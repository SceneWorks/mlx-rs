+array group_norm_affine(
+    const array& x,
+    const array& weight,
+    const array& bias,
+    int num_groups,
+    float eps,
+    StreamOrDevice s_ /* = {} */) {
+  constexpr std::string_view tag = "group_norm_affine";
+  if (x.ndim() < 2) {
+    std::ostringstream msg;
+    msg << "[" << tag << "] Input must have at least 2 dimensions but got "
+        << x.ndim() << " dimensions.";
+    throw std::invalid_argument(msg.str());
+  }
+  if (x.size() == 0) {
+    throw std::invalid_argument(
+        "[group_norm_affine] Empty inputs must use the eager fallback.");
+  }
+  const int channels = x.shape(-1);
+  if (num_groups <= 0 || channels % num_groups != 0) {
+    std::ostringstream msg;
+    msg << "[" << tag << "] Channel count " << channels
+        << " must be divisible by the positive group count " << num_groups
+        << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (weight.ndim() != 1 || weight.size() != channels || bias.ndim() != 1 ||
+      bias.size() != channels) {
+    std::ostringstream msg;
+    msg << "[" << tag << "] Weight and bias must both have shape (" << channels
+        << ").";
+    throw std::invalid_argument(msg.str());
+  }
+  const bool supported_type =
+      x.dtype() == float32 || x.dtype() == float16 || x.dtype() == bfloat16;
+  if (!supported_type || weight.dtype() != x.dtype() ||
+      bias.dtype() != x.dtype()) {
+    throw std::invalid_argument(
+        "[group_norm_affine] Input, weight, and bias must have the same "
+        "float32, float16, or bfloat16 dtype.");
+  }
+
+  auto s = to_stream(s_);
+  if (s.device != Device::gpu) {
+    throw std::invalid_argument(
+        "[group_norm_affine] The exact fused epilogue is Metal-only.");
+  }
+
+  auto fallback = [num_groups, eps, s](const std::vector<array>& inputs) {
+    const auto& x = inputs[0];
+    const auto& weight = inputs[1];
+    const auto& bias = inputs[2];
+    const auto original_shape = x.shape();
+    const int batch = x.shape(0);
+    const int channels = x.shape(-1);
+    const int group_size = channels / num_groups;
+
+    auto grouped = reshape(x, {batch, -1, num_groups, group_size}, s);
+    grouped = transpose(grouped, {0, 2, 1, 3}, s);
+    grouped = reshape(grouped, {batch, num_groups, -1}, s);
+    grouped = layer_norm(grouped, std::nullopt, std::nullopt, eps, s);
+    grouped = reshape(grouped, {batch, num_groups, -1, group_size}, s);
+    grouped = transpose(grouped, {0, 2, 1, 3}, s);
+    auto normed = reshape(grouped, original_shape, s);
+    auto scaled = multiply(normed, weight, s);
+    return std::vector<array>{add(scaled, bias, s)};
+  };
+
+  return array(
+      x.shape(),
+      x.dtype(),
+      std::make_shared<GroupNormAffine>(s, fallback, num_groups, eps),
+      {x, weight, bias});
+}
+
+bool GroupNormAffine::is_equivalent(const Primitive& other) const {
+  const GroupNormAffine& a_other = static_cast<const GroupNormAffine&>(other);
+  return num_groups_ == a_other.num_groups_ && eps_ == a_other.eps_;
+}
