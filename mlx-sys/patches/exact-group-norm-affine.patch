+void GroupNormAffine::eval_gpu(
+    const std::vector<array>& inputs,
+    std::vector<array>& outputs) {
+  auto& s = stream();
+  auto& d = metal::device(s.device);
+  auto& out = outputs[0];
+
+  auto ensure_row_contiguous = [&s](const array& input) {
+    return input.flags().row_contiguous ? input : contiguous_copy_gpu(input, s);
+  };
+
+  const array x = ensure_row_contiguous(inputs[0]);
+  const array weight = ensure_row_contiguous(inputs[1]);
+  const array bias = ensure_row_contiguous(inputs[2]);
+  if (x.is_donatable()) {
+    out.copy_shared_buffer(x);
+  } else {
+    out.set_data(
+        allocator::malloc(x.data_size() * x.itemsize()),
+        x.data_size(),
+        x.strides(),
+        x.flags());
+  }
+
+  const uint32_t batch = x.shape(0);
+  const uint32_t channels = x.shape(-1);
+  const uint32_t num_groups = num_groups_;
+  const uint32_t group_size = channels / num_groups;
+  const uint32_t axis_size = x.size() / (batch * num_groups);
+  const size_t n_rows = static_cast<size_t>(batch) * num_groups;
+
+  constexpr int simd_size = 32;
+  int n_reads = 8;
+  constexpr int looped_limit = 6656;
+  std::string op_name = "group_norm_affine";
+  if (axis_size > looped_limit) {
+    op_name += "_looped";
+    n_reads = 4;
+  }
+  op_name += type_to_name(out);
+
+  auto& compute_encoder = metal::get_command_encoder(s);
+  auto kernel = d.get_kernel(op_name);
+
+  MTL::Size grid_dims;
+  MTL::Size group_dims;
+  if (axis_size <= looped_limit) {
+    size_t threadgroup_needed = (axis_size + n_reads - 1) / n_reads;
+    size_t simds_needed = (threadgroup_needed + simd_size - 1) / simd_size;
+    size_t threadgroup_size = simd_size * simds_needed;
+    if (threadgroup_size > kernel->maxTotalThreadsPerThreadgroup()) {
+      std::ostringstream msg;
+      msg << "[group_norm_affine] Threadgroup size " << threadgroup_size
+          << " is larger than the maximum allowed threadgroup size "
+          << kernel->maxTotalThreadsPerThreadgroup();
+      throw std::runtime_error(msg.str());
+    }
+    grid_dims = MTL::Size(n_rows * threadgroup_size, 1, 1);
+    group_dims = MTL::Size(threadgroup_size, 1, 1);
+  } else {
+    size_t threadgroup_size = kernel->maxTotalThreadsPerThreadgroup();
+    grid_dims = MTL::Size(n_rows * threadgroup_size, 1, 1);
+    group_dims = MTL::Size(threadgroup_size, 1, 1);
+  }
+
+  compute_encoder.set_compute_pipeline_state(kernel);
+  compute_encoder.set_input_array(x, 0);
+  compute_encoder.set_input_array(weight, 1);
+  compute_encoder.set_input_array(bias, 2);
+  compute_encoder.set_output_array(out, 3);
+  compute_encoder.set_bytes(eps_, 4);
+  compute_encoder.set_bytes(axis_size, 5);
+  compute_encoder.set_bytes(group_size, 6);
+  compute_encoder.set_bytes(num_groups, 7);
+  compute_encoder.dispatch_threads(grid_dims, group_dims);
+}
