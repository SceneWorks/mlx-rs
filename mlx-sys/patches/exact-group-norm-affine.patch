+/**
+ * PyTorch-compatible GroupNorm over a channels-last tensor with affine weight
+ * and bias applied in the native Metal normalization epilogue.
+ *
+ * This strict operation preserves the eager
+ * ``layer_norm -> multiply -> add`` dtype-rounding boundaries. It supports
+ * matching float32, float16, or bfloat16 inputs on Metal only and throws for
+ * any unsupported dispatch so callers can truthfully use the eager fallback.
+ */
+MLX_API array group_norm_affine(
+    const array& x,
+    const array& weight,
+    const array& bias,
+    int num_groups,
+    float eps,
+    StreamOrDevice s = {});
+
 MLX_API array rope(
     const array& x,
     int dims,
diff --git a/mlx/fast_primitives.h b/mlx/fast_primitives.h
index 0d2f861..022b2cb 100644
--- a/mlx/fast_primitives.h
+++ b/mlx/fast_primitives.h
@@ -156,6 +156,37 @@ class LayerNormVJP : public Custom {
   float eps_;
 };
 
+class GroupNormAffine : public Custom {
+ public:
+  GroupNormAffine(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      int num_groups,
+      float eps)
+      : Custom(stream, std::move(fallback)),
+        num_groups_(num_groups),
+        eps_(eps) {}
+
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error(
+        "[group_norm_affine] The exact fused epilogue is Metal-only.");
+  }
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+
+  DEFINE_NAME(GroupNormAffine)
+  bool is_equivalent(const Primitive& other) const override;
+  DEFINE_INPUT_OUTPUT_SHAPE()
+  auto state() const {
+    return std::make_tuple(nullptr, num_groups_, eps_);
+  }
+
+ private:
+  int num_groups_;
+  float eps_;
+};
+
 class RoPE : public Custom {
  public:
   RoPE(
diff --git a/tests/gpu_tests.cpp b/tests/gpu_tests.cpp
index d920da4..8663b34 100644
--- a/tests/gpu_tests.cpp
+++ b/tests/gpu_tests.cpp
@@ -686,3 +686,58 @@ TEST_CASE("test layer norm vjp bias grad race") {
   }
   CHECK(worst <= 1e-5);
 }
+
+TEST_CASE("test exact group norm affine epilogue") {
+  auto eager = [](const array& x,
+                  const array& weight,
+                  const array& bias,
+                  int num_groups,
+                  float eps) {
+    const auto shape = x.shape();
+    const int batch = shape.front();
+    const int channels = shape.back();
+    const int group_size = channels / num_groups;
+    auto grouped = reshape(x, {batch, -1, num_groups, group_size});
+    grouped = transpose(grouped, {0, 2, 1, 3});
+    grouped = reshape(grouped, {batch, num_groups, -1});
+    grouped =
+        fast::layer_norm(grouped, std::nullopt, std::nullopt, eps, Device::gpu);
+    grouped = reshape(grouped, {batch, num_groups, -1, group_size});
+    grouped = transpose(grouped, {0, 2, 1, 3});
+    auto normed = reshape(grouped, shape);
+    return add(multiply(normed, weight, Device::gpu), bias, Device::gpu);
+  };
+
+  for (auto dtype : {float32, float16, bfloat16}) {
+    for (auto shape : {Shape{2, 3, 5, 32}, Shape{1, 67, 101, 64}}) {
+      auto x = astype(
+          random::normal(shape, float32, 0.0f, 1.0f, random::key(21)), dtype);
+      auto weight = astype(
+          random::normal({shape.back()}, float32, 0.0f, 1.0f, random::key(22)),
+          dtype);
+      auto bias = astype(
+          random::normal({shape.back()}, float32, 0.0f, 1.0f, random::key(23)),
+          dtype);
+
+      auto reference = eager(x, weight, bias, 8, 1e-5f);
+      auto fused =
+          fast::group_norm_affine(x, weight, bias, 8, 1e-5f, Device::gpu);
+      CHECK(array_equal(reference, fused, Device::cpu).item<bool>());
+    }
+  }
+
+  auto x = random::normal({2, 4, 3, 32}, float32, 0.0f, 1.0f, random::key(24));
+  x = transpose(x, {0, 2, 1, 3});
+  auto weight = random::normal({32}, float32, 0.0f, 1.0f, random::key(25));
+  auto bias = random::normal({32}, float32, 0.0f, 1.0f, random::key(26));
+  CHECK(array_equal(
+            eager(x, weight, bias, 8, 1e-5f),
+            fast::group_norm_affine(x, weight, bias, 8, 1e-5f, Device::gpu),
+            Device::cpu)
+            .item<bool>());
+
+  CHECK_THROWS_WITH_AS(
+      fast::group_norm_affine(x, weight, bias, 8, 1e-5f, Device::cpu),
+      "[group_norm_affine] The exact fused epilogue is Metal-only.",
+      std::invalid_argument);
+}
